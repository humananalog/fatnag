    "meal.late.a11y": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too late. Don't eat now. Go to bed. You won't be hungry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遅すぎ。今は食べない。寝て。空腹にならない。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فات الأوان. لا تأكل الآن. نم. لن تجوع."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Massa tard. No mengis ara. Aneu al llit. No tindreu gana."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozdě. Teď nejez. Jdi spát. Nebudeš mít hlad."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For sent. Spis ikke nu. Gå i seng. Du bliver ikke sulten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu spät. Jetzt nicht essen. Ab ins Bett. Du wirst nicht hungrig sein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πολύ αργά. Μην φας τώρα. Πήγαινε για ύπνο. Δεν θα πεινάσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiado tarde. No comas ahora. Vete a la cama. No tendrás hambre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liian myöhäistä. Älä syö nyt. Mene nukkumaan. Et ole nälkäinen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop tard. Ne mange pas maintenant. Va te coucher. Tu n’auras pas faim."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאוחר מדי. אל תאכל עכשיו. לך לישון. לא תהיה רעב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुत देर। अभी मत खाओ। सो जाओ। भूख नहीं लगेगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prekasno. Ne jedi sada. Idi spavati. Nećeš biti gladan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Túl késő. Ne egyél most. Menj aludni. Nem leszel éhes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlambat. Jangan makan sekarang. Tidur. Kamu tidak akan lapar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppo tardi. Non mangiare ora. Vai a letto. Non avrai fame."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너무 늦었어. 지금 먹지 마. 잠자. 배고프지 않을 거야."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlambat. Jangan makan sekarang. Tidur. Anda tidak akan lapar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For sent. Ikke spis nå. Gå og legg deg. Du blir ikke sulten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te laat. Eet nu niet. Ga slapen. Je wordt niet hongerig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za późno. Nie jedz teraz. Idź spać. Nie będziesz głodny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarde demais. Não coma agora. Vá dormir. Você não vai ter fome."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiado tarde. Não comas agora. Vai para a cama. Não vais ter fome."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prea târziu. Nu mânca acum. Du-te la culcare. Nu o să-ți fie foame."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поздно. Сейчас не ешь. Иди спать. Голодным не будешь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Neskoro. Teraz nejedz. Choď spať. Nebudeš hladný."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För sent. Ät inte nu. Gå och lägg dig. Du blir inte hungrig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สายแล้ว อย่ากินตอนนี้ ไปนอน คุณจะไม่หิว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok geç. Şimdi yeme. Yat. Acıkmayacaksın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запізно. Зараз не їж. Іди спати. Голодним не будеш."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá muộn. Đừng ăn bây giờ. Đi ngủ. Bạn sẽ không đói."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "太晚了，现在不要吃。去睡觉吧，你不会饿的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "太晚了。現在別吃。去睡覺。你不會餓。"
          }
        }
      }
    },
