        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel каже ні. %.1f кг за %d днів це ~%.2f кг/тиж. Безпечний max до %@ ~%.2f кг/тиж. Найраніша чесна дата: %@."
          }
