    "This cannot be undone. Health app data stays unless you delete it there." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن التراجع. تبقى بيانات تطبيق الصحة ما لم تحذفها هناك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això no es pot desfer. Les dades de l’app Salut hi queden, tret que les esborris allà."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To nejde vrátit. Data aplikace Zdraví zůstanou, dokud je tam nesmažeš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det kan ikke fortrydes. Data i appen Sundhed bliver, medmindre du sletter dem der."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das lässt sich nicht rückgängig machen. Die Daten der Health-App bleiben, bis du sie dort löschst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν αναιρείται. Τα δεδομένα της εφαρμογής Υγεία μένουν, εκτός αν τα διαγράψεις εκεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This cannot be undone. Health app data stays unless you delete it there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto no se puede deshacer. Los datos de la app Salud siguen ahí salvo que los borres en ella."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tätä ei voi perua. Terveys-apin tiedot jäävät, ellet poista niitä siellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est irréversible. Les données de l’app Santé restent, sauf si tu les supprimes là-bas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אי אפשר לבטל. נתוני אפליקציית הבריאות נשארים אלא אם תמחק אותם שם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे वापस नहीं लिया जा सकता। स्वास्थ्य ऐप का डेटा वहीं रहता है जब तक तुम उसे वहाँ मिटाओ नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo se ne može poništiti. Podaci aplikacije Zdravlje ostaju osim ako ih tamo ne obrišeš."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezt nem lehet visszavonni. Az Egészség app adatai megmaradnak, hacsak ott nem törlöd."
