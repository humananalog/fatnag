    "settings.alerts.help": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local banners with actions. Focus and Do Not Disturb can still silence them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bannières locales avec actions. Concentration et Ne pas déranger peuvent encore les couper."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクション付きローカルバナー。集中モード等で消えることも。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لافتات محلية بإجراءات. Focus و«عدم الإزعاج» ما زالا قد يكتمبانها."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Banners locals amb accions. Enfoca't i no molestis encara pot silenciar-los."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokální bannery s akcemi. Focus a Nerušit je pořád můžou ztlumit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale banners med handlinger. Fokus og Forstyr ikke kan stadig dæmpe dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Banner mit Aktionen. Fokus und Nicht stören können sie trotzdem stumm halten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τοπικά banners με ενέργειες. Το Focus και το Μην ενοχλείτε μπορούν ακόμα να τα σιγήσουν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Banners locales con acciones. Enfoque y No molestar aún pueden silenciarlos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikalliset bannerit toimilla. Focus ja Älä häiritse voivat silti hiljentää ne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "באנרים מקומיים עם פעולות. Focus ו״נא לא להפריע״ עדיין יכולים להשתיק אותם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रियाओं वाले स्थानीय बैनर। Focus और Do Not Disturb अभी भी चुप कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalni banneri s akcijama. Focus i Ne ometaj i dalje mogu utišati ih."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Helyi bannerek műveletekkel. A Focus és a Ne zavarjanak továbbra is elnémíthatja őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Banner lokal dengan aksi. Focus dan Jangan Ganggu masih bisa membungkam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Banner locali con azioni. Focus e Non disturbare possono ancora silenziarli."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "액션이 있는 로컬 배너. 집중과 방해 금지는 여전히 그들을 침묵시킬 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepanduk tempatan dengan tindakan. Focus dan Do Not Disturb masih boleh senyapkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale bannere med handlinger. Fokus og Ikke forstyrr kan fortsatt dempe dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale banners met acties. Focus en Niet storen kunnen ze alsnog dempen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalne banery z akcjami. Focus i Nie przeszkadzać nadal mogą je wyciszać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Banners locais com ações. Foco e Não Perturbe ainda podem silenciá-los."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Banners locais com ações. Foco e Não incomodar ainda os podem silenciar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Banner-e locale cu acțiuni. Focus și Nu deranja le pot totuși opri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальные баннеры с действиями. Focus и Не беспокоить всё ещё могут их глушить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokálne bannery s akciami. Focus a Nerušiť ich stále môžu stlmiť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokala banners med åtgärder. Fokus och Stör ej kan fortfarande tysta dem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แบนเนอร์ท้องถิ่นพร้อมการกระทำ Focus และห้ามรบกวนยังปิดได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eylemli yerel banner’lar. Focus ve Rahatsız Etme hâlâ susturabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальні банери з діями. Focus і Не турбувати все ще можуть їх глушити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Banner cục bộ có hành động. Focus và Không làm phiền vẫn tắt được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带操作的本地横幅。“专注”和“请勿打扰”仍然可以让他们保持沉默。"
