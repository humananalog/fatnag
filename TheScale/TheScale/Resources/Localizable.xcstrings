    "No recent Health weigh. Drag the dial. Marks follow %@ only." : {
      "comment" : "A description of the onboarding view that appears when the user hasn't taken a recent weigh.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No recent Health weigh. Drag the dial. Marks follow %@ only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay un peso reciente en Salud. Arrastra el dial. Las marcas siguen solo %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de poids récent dans Santé. Fais glisser le cadran. Les graduations suivent seulement %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein aktuelles Gewicht in Health. Zieh am Rad. Die Marken folgen nur %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun peso recente in Salute. Trascina la ghiera. I segni seguono solo %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há peso recente no Saúde. Arraste o dial. As marcas seguem só %@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há peso recente no Saúde. Arrasta o seletor. As marcas seguem só %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルスケアに最近の体重がありません。ダイヤルをドラッグ。目盛りは %@ だけ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "건강에 최근 체중이 없습니다. 다이얼을 드래그하세요. 눈금은 %@만 따릅니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康里没有最近的体重。拖动表盘。刻度只跟随 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康裡沒有最近的體重。拖動刻度。刻度只跟隨 %@。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen recente weging in Health. Sleep de wijzer. De streepjes volgen alleen %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen ny vikt i Health. Dra ratten. Markeringarna följer bara %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen ny vægt i Health. Træk i skiven. Mærkerne følger kun %@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei tuoretta painoa Healthissa. Vedä kiekkoa. Merkit seuraavat vain yksikköä %@."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen ny vekt i Health. Dra hjulet. Merkene følger bare %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak świeżej wagi w Zdrowiu. Przeciągnij tarczę. Znaczniki idą tylko za %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health’te yeni tartı yok. Kadranı sürükle. İşaretler yalnızca %@ izler."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В Здоровье нет недавнего веса. Потяни диск. Метки только в %@."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد وزن حديث في الصحة. اسحب القرص. العلامات تتبع %@ فقط."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वास्थ्य में हाल का वज़न नहीं। डायल खींचें। निशान सिर्फ़ %@ पर चलते हैं।"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีน้ำหนักล่าสุดจากสุขภาพ ลากหน้าปัด ขีดตาม %@ เท่านั้น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có cân gần đây trong Sức khỏe. Kéo vòng số. Vạch chỉ theo %@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada timbangan baru di Health. Seret dial. Tanda hanya mengikuti %@."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada timbangan baharu dalam Health. Seret dail. Tanda hanya ikut %@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין שקילה אחרונה בבריאות. גרור את החוגה. הסימונים עוקבים רק אחרי %@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У Здоров’ї немає недавньої ваги. Потягни диск. Мітки лише в %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve Zdraví není nedávná váha. Táhni ciferník. Značky jedou jen v %@."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχει πρόσφατο βάρος στην Υγεία. Σύρε τον δίσκο. Οι ενδείξεις ακολουθούν μόνο %@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs friss súly az Egészségben. Húzd a tárcsát. A jelek csak a következőt követik: %@."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu există o greutate recentă în Sănătate. Trage de cadran. Marcajele urmează doar %@."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V Zdraví nie je nedávna váha. Ťahaj ciferník. Značky idú len v %@."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nema nedavne težine u Zdravlju. Povuci brojčanik. Oznake prate samo %@."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hi ha un pes recent a Salut. Arrossega el dial. Les marques segueixen només %@."
          }
        }
      }
    },
