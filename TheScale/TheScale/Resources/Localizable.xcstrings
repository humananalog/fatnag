    "Injuries, meds, alcohol, sleep quirks. On-device Coach context only." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إصابات وأدوية وكحول وخصوصيات النوم. سياق Coach على الجهاز فقط."
