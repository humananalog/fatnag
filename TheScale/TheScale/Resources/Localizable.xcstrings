    "Only if you already know it (DEXA, calipers, prior scale). Leave blank if unknown. Typical range about 3-60%." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط إذا كنت تعرفه (DEXA أو المسمك أو ميزان سابق). اتركه فارغًا إن لم تعرفه. النطاق المعتاد نحو 3-60%."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només si ja ho saps (DEXA, plicòmetre, bàscula anterior). Si no, deixa-ho en blanc. Interval habitual, uns 3-60%."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jen pokud to už víš (DEXA, kaliper, předchozí váha). Jinak nech prázdné. Obvyklé rozmezí asi 3–60 %."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun hvis du allerede ved det (DEXA, fedttang, tidligere vægt). Ellers tomt. Typisk interval omkring 3-60%."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur wenn du es schon weißt (DEXA, Caliper, alte Waage). Sonst leer lassen. Üblicher Bereich etwa 3–60 %."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόνο αν το ξέρεις ήδη (DEXA, καλίμπρα, προηγούμενη ζυγαριά). Αλλιώς άφησέ το κενό. Τυπικό εύρος περίπου 3-60%."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only if you already know it (DEXA, calipers, prior scale). Leave blank if unknown. Typical range about 3-60%."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo si ya lo sabes (DEXA, plicómetro, báscula anterior). Déjalo en blanco si no. Rango habitual, unos 3-60 %."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain jos jo tiedät (DEXA, pihti, aiempi vaaka). Muuten tyhjäksi. Tavallinen alue noin 3–60 %."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement si tu le sais déjà (DEXA, pince, ancienne balance). Laisse vide sinon. Fourchette habituelle, environ 3-60 %."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רק אם כבר ידוע לך (DEXA, קליפר, משקל קודם). אחרת השאר ריק. טווח אופייני בערך 3-60%."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ तभी जब तुम्हें पता हो (DEXA, कैलिपर, पुराना स्केल)। नहीं पता तो खाली छोड़ो। आम सीमा लगभग 3-60%."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samo ako već znaš (DEXA, kaliper, prethodna vaga). Inače ostavi prazno. Uobičajeni raspon oko 3-60%."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
