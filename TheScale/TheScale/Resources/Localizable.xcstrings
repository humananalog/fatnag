    "settings.redo_onboarding.help" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walk through setup again. Every saved answer is already filled in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recorre la configuración otra vez. Cada respuesta guardada ya está rellenada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refais la configuration. Chaque réponse enregistrée est déjà remplie."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geh die Einrichtung noch einmal durch. Jede gespeicherte Antwort ist schon ausgefüllt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rifai la configurazione. Ogni risposta salvata è già compilata."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe pela configuração de novo. Cada resposta salva já está preenchida."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percorre a configuração outra vez. Cada resposta guardada já está preenchida."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定をもう一度。保存した回答はすべて入っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정을 다시 걷습니다. 저장한 답은 이미 채워져 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再走一遍设置。已保存的答案都填好了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再走一遍設定。已儲存的答案都填好了。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loop de setup nog eens door. Elk opgeslagen antwoord staat er al in."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå igenom inställningen igen. Varje sparat svar är redan ifyllt."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå opsætningen igennem igen. Hvert gemt svar er allerede udfyldt."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käy asetukset uudelleen. Jokainen tallennettu vastaus on jo täytetty."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå gjennom oppsettet igjen. Hvert lagret svar er allerede fylt inn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przejdź konfigurację jeszcze raz. Każda zapisana odpowiedź jest już uzupełniona."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurulumu yeniden gez. Kayıtlı her yanıt zaten dolu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пройди настройку снова. Каждый сохранённый ответ уже подставлен."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امشِ الإعداد مرة أخرى. كل إجابة محفوظة معبأة مسبقًا."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेटअप फिर चलें। हर सेव जवाब पहले से भरा है।"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เดินการตั้งค่าอีกครั้ง คำตอบที่บันทึกถูกเติมไว้แล้ว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đi lại phần thiết lập. Mọi câu trả lời đã lưu đều được điền sẵn."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jalani pengaturan lagi. Setiap jawaban tersimpan sudah terisi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jalani persediaan semula. Setiap jawapan tersimpan sudah diisi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עבור שוב על ההגדרה. כל תשובה שמורה כבר ממולאת."
