    "Skip anytime. We'll ask gently later, not every day." : {
      "comment" : "A description of the benefits of skipping the profile gap prompt.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skip anytime. We'll ask gently later, not every day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes omitir cuando quieras. Preguntaremos con calma más tarde, no cada día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux passer quand tu veux. On redemandera doucement plus tard, pas tous les jours."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst jederzeit überspringen. Wir fragen später sanft, nicht jeden Tag."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi saltare quando vuoi. Chiederemo con calma più tardi, non ogni giorno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode pular quando quiser. Vamos perguntar com calma depois, não todo dia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podes ignorar quando quiseres. Perguntamos com calma mais tarde, não todos os dias."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いつでもスキップできます。あとでそっと聞きます。毎日は聞きません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "언제든 건너뛸 수 있습니다. 나중에 부드럽게 묻고, 매일 묻지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随时可以跳过。我们以后轻轻问，不会每天问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隨時可以略過。我們以後輕輕問，不會每天問。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt altijd overslaan. We vragen later zacht, niet elke dag."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoppa över när du vill. Vi frågar mjukt senare, inte varje dag."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spring over når som helst. Vi spør blidt senere, ikke hver dag."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit ohittaa milloin vain. Kysymme myöhemmin hellästi, emme joka päivä."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hopp over når du vil. Vi spør pent senere, ikke hver dag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz pominąć w każdej chwili. Zapytamy łagodnie później, nie codziennie."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstediğin zaman atla. Sonra nazikçe sorarız, her gün değil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно пропустить когда угодно. Спросим позже мягко, не каждый день."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك التخطي في أي وقت. نسأل بلطف لاحقًا، وليس كل يوم."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कभी भी छोड़ सकते हो। बाद में हल्के से पूछेंगे, हर दिन नहीं।"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้ามได้ทุกเมื่อ เราจะถามเบาๆ ทีหลัง ไม่ใช่ทุกวัน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bỏ qua lúc nào cũng được. Chúng tôi hỏi nhẹ sau, không hỏi mỗi ngày."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lewati kapan saja. Kami akan bertanya pelan nanti, tidak setiap hari."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langkau bila-bila. Kami akan bertanya perlahan kemudian, bukan setiap hari."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לדלג מתי שרוצים. נשאל בעדינות אחר כך, לא כל יום."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можна пропустити будь-коли. Запитаємо пізніше м’яко, не щодня."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přeskočit můžeš kdykoli. Zeptáme se později jemně, ne každý den."
