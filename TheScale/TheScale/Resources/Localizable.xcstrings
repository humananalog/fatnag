    "Subscriptions via Apple. Restore if you already bought Plus or Pro on this Apple ID." : {
      "comment" : "A description of the user's subscription status.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscriptions via Apple. Restore if you already bought Plus or Pro on this Apple ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las suscripciones van por Apple. Restaura si ya compraste Plus o Pro con este Apple ID."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les abonnements passent par Apple. Restaure si tu as déjà acheté Plus ou Pro avec cet Apple ID."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abos laufen über Apple. Stelle wieder her, wenn du Plus oder Pro schon mit dieser Apple-ID gekauft hast."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli abbonamenti passano da Apple. Ripristina se hai già comprato Plus o Pro con questo Apple ID."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As assinaturas são pela Apple. Restaure se você já comprou Plus ou Pro com este Apple ID."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As subscrições são pela Apple. Restaura se já compraste Plus ou Pro com este Apple ID."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブスクリプションは Apple 経由。この Apple ID で Plus または Pro を購入済みなら復元してください。"
