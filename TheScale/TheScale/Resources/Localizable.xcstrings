        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin techo blando. %d créditos Keel LIVE a la semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de plafond mou. %d crédits Keel live par semaine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun tetto morbido. %d crediti Keel LIVE a settimana."
