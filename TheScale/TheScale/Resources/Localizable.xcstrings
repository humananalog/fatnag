        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊंचाई, वज़न, वैकल्पिक BF%। इकाइयाँ लाइव कन्वर्ट।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visina, težina, opcionalno BF%. Jedinice se pretvaraju uživo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Magasság, súly, opcionális BF%. Az egységek élőben váltanak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinggi, berat, BF% opsional. Satuan konversi live."
          }
        },
        "ms": {
