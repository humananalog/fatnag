    "live.weight_only.body": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُلتقط تركيب الجسم، لذا لن تُكتب نسبة الدهون. ما زال يمكنك تعديل الوزن قبل التأكيد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Körperzusammensetzung erfasst, daher wird Körperfett % nicht geschrieben. Gewicht kannst du vor dem Bestätigen noch ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No body composition was captured, so body fat % will not be written. You can still edit weight before confirming."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se capturó composición corporal, así que el % de grasa no se escribirá. Aún puedes editar el peso antes de confirmar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune composition corporelle capturée : le % de graisse ne sera pas écrit. Tu peux encore modifier le poids avant de confirmer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna composizione corporea catturata, quindi il % di grasso non verrà scritto. Puoi ancora modificare il peso prima di confermare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体組成が取れなかったため体脂肪％は書きません。確定前に体重は編集できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체성분이 포착되지 않았으므로 체지방 % 는 기록되지 않습니다. 확인하기 전에 몸무게를 수정할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen lichaamssamenstelling vastgelegd, dus vet % wordt niet geschreven. Je kunt gewicht nog bewerken vóór bevestigen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma composição corporal capturada, então o % de gordura não será gravado. Você ainda pode editar o peso antes de confirmar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Состав тела не пойман, поэтому % жира не запишется. Вес ещё можно править до подтверждения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未捕获身体成分，因此不会写入身体脂肪百分比。在确认之前，您仍然可以编辑重量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未擷取體成分，因此不會寫入體脂 %。確認前仍可編輯體重。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha capturat cap composició corporal, per la qual cosa no s'escriurà el % de greix corporal. Encara pots modificar el pes abans de confirmar-ho."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Složení těla se nezachytilo, takže % tuku se nezapíše. Váhu můžeš ještě upravit před potvrzením."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen kropssammensætning blev fanget, så kropsfedt % skrives ikke. Du kan stadig redigere vægt før bekræftelse."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν καταγράφηκε σύσταση σώματος, οπότε το % λίπους δεν θα γραφτεί. Μπορείς ακόμα να επεξεργαστείς το βάρος πριν την επιβεβαίωση."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehonkoostumusta ei tallennettu, joten rasva %:ia ei kirjoiteta. Voit silti muokata painoa ennen vahvistusta."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נתפס הרכב גוף, לכן אחוז השומן לא ייכתב. עדיין אפשר לערוך משקל לפני אישור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बॉडी कंपोज़िशन कैप्चर नहीं हुआ, इसलिए फैट % नहीं लिखा जाएगा। पुष्टि से पहले वज़न संपादित कर सकते हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sastav tijela nije uhvaćen, pa se % masti neće zapisati. I dalje možeš urediti težinu prije potvrde."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem rögzült testösszetétel, ezért a testzsír % nem kerül mentésre. A súlyt még szerkesztheted megerősítés előtt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Komposisi tubuh tidak tertangkap, jadi lemak % tidak ditulis. Masih bisa edit berat sebelum konfirmasi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada komposisi badan, jadi lemak % tidak ditulis. Anda masih boleh edit berat sebelum sahkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen kroppssammensetning ble fanget, så kroppsfett % skrives ikke. Du kan fortsatt redigere vekt før bekreftelse."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie złapano składu ciała, więc % tłuszczu nie zostanie zapisany. Wagę możesz jeszcze edytować przed potwierdzeniem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma composição corporal capturada, por isso o % de gordura não será gravado. Ainda podes editar o peso antes de confirmar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a capturat compoziție corporală, deci % grăsime nu se va scrie. Poți edita greutatea înainte de confirmare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zloženie tela sa nezachytilo, takže % tuku sa nezapíše. Váhu môžeš ešte upraviť pred potvrdením."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen kroppssammansättning fångades, så kroppsfett % skrivs inte. Du kan fortfarande redigera vikt innan bekräftelse."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่จับองค์ประกอบร่างกายได้ จึงไม่เขียนไขมัน % ยังแก้ kg ก่อนยืนยันได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücut kompozisyonu yakalanmadı, bu yüzden yağ % yazılmayacak. Onaylamadan önce ağırlığı hâlâ düzenleyebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Склад тіла не спіймано, тож % жиру не запишеться. Вагу ще можна правити перед підтвердженням."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không bắt được thành phần cơ thể nên mỡ % không được ghi. Vẫn sửa cân trước khi xác nhận."
          }
        }
      }
    },
