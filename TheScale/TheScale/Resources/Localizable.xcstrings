          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem ír Apple Healthbe. A testzsír % csak informatív a kalibrálás alatt."
          }
        },
        "id" : {
          "stringUnit" : {
