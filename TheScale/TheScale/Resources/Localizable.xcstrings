        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura, peso, %GC opcional. Las unidades convierten en vivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille, poids, %MG optionnel. Les unités convertissent en direct."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altezza, peso, %GC opzionale. Le unità convertono in diretta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "身長・体重・任意の体脂肪％。単位はライブ変換。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "높이, 무게, 옵션 BF %. 단위는 실시간으로 변환됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lengte, gewicht, optioneel BF%. Eenheden converteren live."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura, peso, %GC opcional. Unidades convertem ao vivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рост, вес, опционально BF%. Единицы конвертируются на лету."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "身高、体重、可选BF %。单位实时转换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "身高、體重、可選體脂%。單位即時換算。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Alçada, pes, % BF opcional. Unitats convertides en directe."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výška, váha, volitelně BF%. Jednotky se živě převádějí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Højde, vægt, valgfrit BF%. Enheder konverterer live."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ύψος, βάρος, προαιρετικά BF%. Οι μονάδες μετατρέπονται ζωντανά."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pituus, paino, valinnainen BF%. Yksiköt muuntuvat livenä."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גובה, משקל, BF% אופציונלי. יחידות ממירות בלייב."
