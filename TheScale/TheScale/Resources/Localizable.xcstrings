    "meal.late.a11y" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فات الأوان. لا تأكل الآن. نم. لن تجوع."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Massa tard. No mengis ara. Aneu al llit. No tindreu gana."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozdě. Teď nejez. Jdi spát. Nebudeš mít hlad."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For sent. Spis ikke nu. Gå i seng. Du bliver ikke sulten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu spät. Jetzt nicht essen. Ab ins Bett. Du wirst nicht hungrig sein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πολύ αργά. Μην φας τώρα. Πήγαινε για ύπνο. Δεν θα πεινάσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too late. Don't eat now. Go to bed. You won't be hungry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiado tarde. No comas ahora. Vete a la cama. No tendrás hambre."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liian myöhäistä. Älä syö nyt. Mene nukkumaan. Et ole nälkäinen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop tard. Ne mange pas maintenant. Va te coucher. Tu n’auras pas faim."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאוחר מדי. אל תאכל עכשיו. לך לישון. לא תהיה רעב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बहुत देर। अभी मत खाओ। सो जाओ। भूख नहीं लगेगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prekasno. Ne jedi sada. Idi spavati. Nećeš biti gladan."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Túl késő. Ne egyél most. Menj aludni. Nem leszel éhes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terlambat. Jangan makan sekarang. Tidur. Kamu tidak akan lapar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troppo tardi. Non mangiare ora. Vai a letto. Non avrai fame."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遅すぎ。今は食べない。寝て。空腹にならない。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "너무 늦었어. 지금 먹지 마. 잠자. 배고프지 않을 거야."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terlambat. Jangan makan sekarang. Tidur. Anda tidak akan lapar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
