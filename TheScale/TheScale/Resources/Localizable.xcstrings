    "paywall.credits_line": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأرصدة لا تشتري متعة. تشتري نتائج أفضل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Credits kaufen kein Vergnügen. Credits kaufen bessere Ergebnisse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Credits do not buy pleasure. Credits buy better outcomes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los créditos no compran placer. Compran mejores resultados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les crédits n’achètent pas le plaisir. Ils achètent de meilleurs résultats."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I crediti non comprano piacere. Comprano risultati migliori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クレジットは快楽のためではない。より良い結果のため。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크레딧은 즐거움을 사지 않습니다. 크레딧은 더 나은 결과를 만듭니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Credits kopen geen genot. Credits kopen betere uitkomsten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Créditos não compram prazer. Compram resultados melhores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредиты не покупают удовольствие. Кредиты покупают лучший результат."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "积分买不到快乐。积分可以带来更好的结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點數不買快感。點數買更好結果。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els crèdits no compren plaer. Els crèdits compren millors resultats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredity nekupují požitek. Kredity kupují lepší výsledky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Credits køber ikke nydelse. Credits køber bedre resultater."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα credits δεν αγοράζουν απόλαυση. Αγοράζουν καλύτερα αποτελέσματα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Creditit eivät osta nautintoa. Creditit ostavat parempia tuloksia."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קרדיטים לא קונים הנאה. קרדיטים קונים תוצאות טובות יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रेडिट आनंद नहीं खरीदते। क्रेडिट बेहतर नतीजे खरीदते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Krediti ne kupuju užitak. Krediti kupuju bolje ishode."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kreditek nem élvezetet vesznek. Jobb eredményeket vesznek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit tidak membeli kesenangan. Kredit membeli hasil lebih baik."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit tidak membeli keseronokan. Kredit membeli hasil lebih baik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreditter kjøper ikke nytelse. Kreditter kjøper bedre resultater."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredyty nie kupują przyjemności. Kredyty kupują lepsze wyniki."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os créditos não compram prazer. Compram melhores resultados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Creditele nu cumpără plăcere. Cumpără rezultate mai bune."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredity nekupujú pôžitok. Kredity kupujú lepšie výsledky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Krediter köper inte njutning. Krediter köper bättre utfall."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครดิตไม่ซื้อความเพลิดเพลิน เครดิตซื้อผลลัพธ์ที่ดีกว่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Krediler zevk satın almaz. Daha iyi sonuç satın alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
