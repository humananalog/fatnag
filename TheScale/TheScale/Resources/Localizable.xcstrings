    "live.cal.no_health": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يكتب إلى Apple Health. نسبة الدهون معلوماتية فقط أثناء المعايرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibt nicht in Apple Health. Körperfett % ist während der Kalibrierung nur informativ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does not write to Apple Health. Body fat % is informational only during calibration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No escribe en Apple Health. El % de grasa es solo informativo durante la calibración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’écrit pas dans Apple Santé. Le % de graisse est informatif pendant la calibration."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non scrive su Apple Health. Il % di grasso è solo informativo durante la calibrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Healthには書きません。校正中の体脂肪％は参考情報のみ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health에 편지를 쓰지 않습니다. 체지방 % 는 보정 중에만 정보를 제공합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijft niet naar Apple Health. Vet % is alleen informatief tijdens kalibratie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não grava no Apple Health. O % de gordura é só informativo durante a calibração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не пишет в Apple Health. % жира только информативно при калибровке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不写信给Apple Health。体脂%仅在校准期间提供信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不寫入 Apple Health。校正期間體脂 % 僅供參考。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No escriu a Apple Health. El % de greix corporal només és informatiu durant la calibració."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nezapisuje do Apple Health. % tuku je při kalibraci jen informativní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriver ikke til Apple Health. Kropsfedt % er kun informativ under kalibrering."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν γράφει στο Apple Health. Το % λίπους είναι μόνο ενημερωτικό κατά τη βαθμονόμηση."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei kirjoita Apple Healthiin. Rasva % on vain informatiivinen kalibroinnin aikana."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא כותב ל־Apple Health. אחוז השומן אינפורמטיבי בלבד בכיול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health में नहीं लिखता। कैलिब्रेशन के दौरान बॉडी फैट % केवल जानकारी के लिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne piše u Apple Health. % masti je samo informativan tijekom kalibracije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem ír Apple Healthbe. A testzsír % csak informatív a kalibrálás alatt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak menulis ke Apple Health. Lemak tubuh % hanya informatif saat kalibrasi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak menulis ke Apple Health. Lemak % hanya maklumat semasa penentukuran."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriver ikke til Apple Health. Kroppsfett % er kun informativ under kalibrering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zapisuje do Apple Health. % tłuszczu tylko informacyjnie podczas kalibracji."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não grava no Apple Health. O % de gordura é só informativo durante a calibração."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu scrie în Apple Health. % grăsime e doar informativ în timpul calibrării."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nezapisuje do Apple Health. % tuku je pri kalibrácii len informatívny."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriver inte till Apple Health. Kroppsfett % är endast informativt under kalibrering."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่เขียนไป Apple Health ไขมัน % เป็นข้อมูลอย่างเดียวตอนปรับเทียบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health’e yazmaz. Kalibrasyonda yağ % yalnızca bilgilendirici."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не пише в Apple Health. % жиру лише інформативно під час калібрування."
