      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملخص اتجاه وزن/دهون قصير فقط يذهب إلى Keel عند الضغط على roast. ألغِ في الإعدادات."
