    "onboarding.confirm.medical_body" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach تدريب رياضي تعليمي وليس نصيحة طبية. لا يشخّص ولا يعالج ولا يحل محل طبيب. إن شعرت بشيء خطأ، كلم طبيبًا حقيقيًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach és entrenament esportiu educatiu, no consell mèdic. No diagnostica, no tracta, no substitueix un metge. Si alguna cosa no quadra, parla amb un metge de veritat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach je vzdělávací fitness koučování, ne lékařská rada. Nediagnostikuje, neléčí, nenahrazuje lékaře. Něco nesedí? Promluv si s opravdovým doktorem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach er pædagogisk fitness-coaching, ikke lægelig rådgivning. Diagnostiserer, behandler eller erstatter ikke en læge. Hvis noget føles forkert, tal med en rigtig læge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach ist pädagogisches Fitness-Coaching, kein ärztlicher Rat. Keine Diagnose, keine Behandlung, ersetzt keinen Arzt. Wenn etwas falsch fühlt, sprich mit einem echten Arzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο Coach είναι εκπαιδευτικό fitness coaching, όχι ιατρική συμβουλή. Δεν διαγνώσκει, δεν θεραπεύει, δεν αντικαθιστά γιατρό. Κάτι φαίνεται λάθος; Μίλησε με πραγματικό γιατρό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach is educational fitness coaching, not medical advice. It does not diagnose, treat, or replace a clinician. If something feels wrong, talk to a real doctor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach es entrenamiento fitness educativo, no consejo médico. No diagnostica, no trata, no sustituye a un médico. Si algo se siente mal, habla con un médico de verdad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach on opetuksellista fitness-valmennusta, ei lääketieteellistä neuvoa. Se ei diagnoosaa, ei hoitaa, ei korvaa lääkäriä. Jos jokin tuntuu väärältä, puhu oikealle lääkärille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach est un coaching fitness éducatif, pas un avis médical. Il ne diagnostique pas, ne traite pas, ne remplace pas un médecin. Si quelque chose cloche, parle à un vrai médecin."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach הוא אימון כושר חינוכי, לא ייעוץ רפואי. לא מאבחן, לא מטפל, לא מחליף רופא. משהו מרגיש לא בסדר? דבר עם רופא אמיתי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach शैक्षणिक फ़िटनेस कोचिंग है, चिकित्सीय सलाह नहीं। यह निदान, इलाज या डॉक्टर का विकल्प नहीं। कुछ ग़लत लगे तो असली डॉक्टर से बात करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach je edukativno fitness-coaching, ne medicinski savjet. Ne dijagnosticira, ne liječi, ne zamjenjuje liječnika. Ako nešto ne štima, razgovaraj s pravim liječnikom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Coach oktató jellegű fitnesz-coaching, nem orvosi tanács. Nem diagnosztizál, nem kezel, nem helyettesíti az orvost. Ha valami nem stimmel, beszélj egy igazi orvossal."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach adalah coaching fitness edukatif, bukan saran medis. Tidak mendiagnosis, mengobati, atau menggantikan dokter. Kalau ada yang terasa salah, bicara dengan dokter sungguhan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach è coaching fitness educativo, non consiglio medico. Non diagnostica, non tratta, non sostituisce un medico. Se qualcosa non quadra, parla con un medico vero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coachは教育的フィットネスコーチングであり、医療アドバイスではありません。診断・治療・医師の代わりにはなりません。おかしいと感じたら本物の医師に相談を。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach는 교육용 피트니스 코칭이며 의료 조언이 아닙니다. 진단·치료·의사 대체가 아닙니다. 이상하면 진짜 의사에게 말하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach ialah coaching fitness pendidikan, bukan nasihat perubatan. Tidak diagnosis, rawat, atau ganti doktor. Kalau rasa tak kena, cakap dengan doktor sebenar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach er pedagogisk fitness-coaching, ikke medisinsk råd. Diagnostiserer, behandler eller erstatter ikke lege. Hvis noe føles feil, snakk med en ekte lege."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach is educatieve fitness-coaching, geen medisch advies. Geen diagnose, geen behandeling, vervangt geen arts. Voelt iets verkeerd? Praat met een echte arts."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach to edukacyjny coaching fitness, nie porada medyczna. Nie diagnozuje, nie leczy, nie zastępuje lekarza. Coś nie tak? Porozmawiaj z prawdziwym lekarzem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach é coaching fitness educativo, não conselho médico. Não diagnostica, não trata, não substitui médico. Se algo parece errado, fale com um médico de verdade."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Coach é coaching fitness educativo, não conselho médico. Não diagnostica, não trata, não substitui um médico. Se algo parecer errado, fala com um médico a sério."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach este coaching fitness educațional, nu sfat medical. Nu diagnostichează, nu tratează, nu înlocuiește un medic. Dacă ceva nu e în regulă, vorbește cu un medic adevărat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach - образовательный фитнес-коучинг, не медсовет. Не диагностирует, не лечит, не заменяет врача. Что-то не так - поговорите с настоящим врачом."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach je vzdelávany fitness-coaching, nie lekárska rada. Nediagnostikuje, nelieči, nenahradí lekára. Niečo nesedí? Prehovor s pravým doktorom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach är pedagogisk fitness-coaching, inte medicinsk rådgivning. Diagnostiserar, behandlar eller ersätter inte läkare. Om något känns fel, prata med en riktig läkare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach คือการโค้ชฟิตเนสเชิงการศึกษา ไม่ใช่คำแนะนำทางการแพทย์ ไม่วินิจฉัย ไม่รักษา ไม่แทนแพทย์ ถ้ารู้สึกผิดปกติ ให้คุยกับแพทย์จริง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach eğitimsel fitness-coaching'tir, tıbbi tavsiye değildir. Teşhis koymaz, tedavi etmez, doktorun yerini tutmaz. Bir şey yanlış hissediyorsan, gerçek bir doktorla konuş."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach - освітній фітнес-коучинг, не медрада. Не діагностує, не лікує, не замінює лікаря. Щось не так - поговори зі справжнім лікарем."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach là coaching fitness giáo dục, không phải lời khuyên y khoa. Không chẩn đoán, không điều trị, không thay bác sĩ. C gì sai, nói chuyện với bác sĩ thật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach 是教育性健身辅导，不是医疗建议。不诊断、不治疗、不替代医生。感觉不对，就找真正的医生。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach 是教育性健身輔導，不是醫療建議。不診斷、不治療、不取代醫生。感覺不對，就找真正的醫生。"
          }
        }
      }
    },
