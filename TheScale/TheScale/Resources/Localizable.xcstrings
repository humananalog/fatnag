    "notif.active_footer": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to open the related page. Swipe left to delete or archive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche pour ouvrir la page liée. Glisse à gauche pour supprimer ou archiver."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップで関連ページを開く。左スワイプで削除またはアーカイブ。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط لفتح الصفحة ذات الصلة. اسحب يسارًا للحذف أو الأرشفة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca per obrir la pàgina relacionada. Llisca cap a l'esquerra per eliminar-lo o arxivar-lo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepni pro otevření související stránky. Swipe doleva pro smazání nebo archivaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk for at åbne den relaterede side. Stryg til venstre for at slette eller arkivere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen öffnet die passende Seite. Nach links wischen zum Löschen oder Archivieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτα για άνοιγμα σχετικής σελίδας. Σύρε αριστερά για διαγραφή ή αρχειοθέτηση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para abrir la página relacionada. Desliza a la izquierda para eliminar o archivar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta avataksesi liittyvän sivun. Pyyhkäise vasemmalle poistaaksesi tai arkistoidaksesi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש לפתיחת העמוד הקשור. החלק שמאלה למחיקה או לארכיון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संबंधित पेज खोलने के लिए टैप करें। हटाने या आर्काइव के लिए बाएँ स्वाइप।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni za otvaranje povezane stranice. Swipe lijevo za brisanje ili arhiviranje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a kapcsolódó oldal megnyitásához. Húzd balra a törléshez vagy archiváláshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk untuk buka halaman terkait. Geser kiri untuk hapus atau arsip."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per aprire la pagina correlata. Scorri a sinistra per eliminare o archiviare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관련 페이지를 열려면 누르세요. 왼쪽으로 밀어 삭제하거나 보관합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik untuk buka halaman berkaitan. Leret kiri untuk padam atau arkib."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk for å åpne den relaterte siden. Sveip til venstre for å slette eller arkivere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik om de gerelateerde pagina te openen. Veeg links om te verwijderen of archiveren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij, by otworzyć powiązaną stronę. Przesuń w lewo, by usunąć lub zarchiwizować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para abrir a página relacionada. Deslize à esquerda para apagar ou arquivar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para abrir a página relacionada. Desliza para a esquerda para apagar ou arquivar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge pentru a deschide pagina legată. Glisează stânga ca să ștergi sau arhivezi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми, чтобы открыть связанную страницу. Свайп влево — удалить или в архив."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepni na otvorenie súvisiacej stránky. Swipe doľava na zmazanie alebo archiváciu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck för att öppna relaterad sida. Svep vänster för att radera eller arkivera."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเพื่อเปิดหน้าเกี่ยวข้อง ปัดซ้ายเพื่อลบหรือเก็บถาวร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlgili sayfayı açmak için dokun. Silmek veya arşivlemek için sola kaydır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкнись, щоб відкрити пов’язану сторінку. Свайп ліворуч — видалити або в архів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm để mở trang liên quan. Vuốt trái để xóa hoặc lưu trữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻触以打开相关页面。向左滑动以删除或存档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下打開相關頁面。左滑刪除或封存。"
          }
        }
      }
    },
