    "paywall.cancel_note.annual" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك الإلغاء في أي وقت من اشتراكات App Store. يتجدد سنويًا حتى تلغي قبل 24 ساعة على الأقل من نهاية الفترة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancel·la quan vulguis a les subscripcions de l’App Store. Es renova cada any fins que cancel·lis almenys 24 hores abans que acabi el període."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zruš kdykoli v předplatném App Store. Obnovuje se každý rok, dokud nezrušíš alespoň 24 hodin před koncem období."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuller når som helst i App Store-abonnementer. Fornyes årligt, indtil du annullerer mindst 24 timer før periodens udløb."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jederzeit in den App-Store-Abos kündbar. Verlängert sich jährlich, bis du mindestens 24 Stunden vor Periodenende kündigst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ακύρωση οποιαδήποτε στιγμή στις συνδρομές του App Store. Ανανεώνεται ετησίως μέχρι να ακυρώσεις τουλάχιστον 24 ώρες πριν το τέλος της περιόδου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancel anytime in App Store subscriptions. Auto-renews yearly until you cancel at least 24 hours before the period ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancela cuando quieras en las suscripciones del App Store. Se renueva sola cada año hasta que canceles al menos 24 horas antes de que acabe el periodo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peru milloin vain App Storen tilauksissa. Uusitaan vuosittain, kunnes peruutat vähintään 24 tuntia ennen jakson loppua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annule quand tu veux dans les abonnements de l’App Store. Se renouvelle chaque année jusqu’à ce que tu annules au moins 24 heures avant la fin de la période."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לבטל בכל עת במנויי App Store. מתחדש מדי שנה עד שתבטל לפחות 24 שעות לפני סוף התקופה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store सब्सक्रिप्शन में कभी भी रद्द करें। अवधि खत्म होने से कम से कम 24 घंटे पहले रद्द करने तक हर साल अपने आप नवीनीकृत होता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otkaži bilo kada u pretplatama App Storea. Obnavlja se godišnje dok ne otkažeš najmanje 24 sata prije kraja razdoblja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bármikor lemondható az App Store-előfizetésekben. Évente megújul, amíg legalább 24 órával a periódus vége előtt le nem mondod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batalkan kapan saja di langganan App Store. Diperpanjang otomatis tiap tahun sampai kamu membatalkan setidaknya 24 jam sebelum periode berakhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annulla quando vuoi negli abbonamenti dell’App Store. Si rinnova ogni anno finché non annulli almeno 24 ore prima della fine del periodo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store のサブスクリプションでいつでも解約できます。期間終了の 24 時間前までに解約するまで、毎年自動更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store 구독에서 언제든 취소할 수 있습니다. 기간이 끝나기 최소 24시간 전에 취소할 때까지 매년 자동 갱신됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batal bila-bila masa dalam langganan App Store. Diperbaharui automatik setiap tahun sehingga anda membatalkan sekurang-kurangnya 24 jam sebelum tempoh tamat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avbryt når som helst i App Store-abonnementer. Fornyes årlig til du avslutter minst 24 timer før perioden slutter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altijd opzegbaar in App Store-abonnementen. Verlengt jaarlijks tot je minstens 24 uur voor het einde opzegt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anuluj kiedy chcesz w subskrypcjach App Store. Odnawia się co rok, aż anulujesz co najmniej 24 godziny przed końcem okresu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancele quando quiser nas assinaturas da App Store. Renova sozinho todo ano até você cancelar pelo menos 24 horas antes do fim do período."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancela quando quiseres nas subscrições da App Store. Renova-se todos os anos até cancelares pelo menos 24 horas antes do fim do período."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anulează oricând din abonamentele App Store. Se reînnoiește anual până anulezi cu cel puțin 24 de ore înainte de sfârșitul perioadei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отмена в любой момент в подписках App Store. Продлевается каждый год, пока не отменишь хотя бы за 24 часа до конца периода."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zruš kedykoľvek v predplatnom App Store. Obnovuje sa každý rok, kým nezrušíš aspoň 24 hodín pred koncom obdobia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avsluta när du vill i App Store-prenumerationer. Förnyas varje år tills du avslutar minst 24 timmar före periodens slut."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยกเลิกได้ทุกเมื่อในการสมัครของ App Store ต่ออายุรายปีจนกว่าคุณจะยกเลิกอย่างน้อย 24 ชั่วโมงก่อนจบรอบ"
