          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peso em streaming. O % de gordura aparece quando a balança terminar o scan."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
