    "settings.alerts.denied": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach cannot fire drills while denied. Tap System, then allow alerts for FATNAG."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Coach ne peut pas envoyer de drills si c’est refusé. Tape Système, puis autorise les alertes pour FATNAG."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拒否中はコーチのドリルが打てません。システムをタップし、FATNAGのアラートを許可。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع Coach إطلاق التدريبات أثناء الرفض. اضغط النظام ثم اسمح بتنبيهات FATNAG."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'entrenador no pot fer simulacres de foc mentre es nega. Toca Sistema i, a continuació, permet que apareguin alertes per a FATNAG."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach nemůže spouštět drilly, když je to odepřeno. Klepni Systém, pak povol upozornění pro FATNAG."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach kan ikke affyre drills, mens nægtet. Tryk System, tillad derefter advarsler for FATNAG."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach kann keine Drills feuern, solange verweigert. Tippe System, dann Hinweise für FATNAG erlauben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο Coach δεν μπορεί να πυροδοτήσει drills όσο είναι denied. Πάτα Σύστημα, μετά επίτρεψε ειδοποιήσεις για FATNAG."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach no puede lanzar drills mientras esté denegado. Toca Sistema y permite alertas para FATNAG."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach ei voi laukaista driillejä kun estetty. Napauta Järjestelmä, salli sitten hälytykset FATNAGille."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach לא יכול לירות drills כשההרשאה נדחתה. הקש מערכת ואז אפשר התראות ל־FATNAG."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मना होने पर Coach ड्रिल नहीं चला सकता। सिस्टम टैप करें, फिर FATNAG के लिए अलर्ट अनुमति दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach ne može okidati drillove dok je odbijeno. Dodirni Sustav, zatim dopusti upozorenja za FATNAG."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Coach nem tud drillt indítani, ha megtagadod. Koppints a Rendszerre, majd engedd az értesítéseket a FATNAG-nak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach tidak bisa menembak drill saat ditolak. Ketuk Sistem, lalu izinkan peringatan untuk FATNAG."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach non può lanciare drill se è negato. Tocca Sistema, poi consenti gli avvisi per FATNAG."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코치는 거부된 상태에서 훈련을 발사할 수 없습니다. 시스템 을 누른 다음 FATNAG에 대한 알림을 허용합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach tidak boleh pecut drill bila ditolak. Ketik System, kemudian benarkan makluman untuk FATNAG."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach kan ikke avfyre drills mens nektet. Trykk System, tillat deretter varsler for FATNAG."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach kan geen drills afvuren zolang geweigerd. Tik Systeem, sta dan meldingen voor FATNAG toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach nie odpali drillów, gdy odmówisz. Dotknij System, potem zezwól na alerty dla FATNAG."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach não dispara drills enquanto estiver negado. Toque Sistema e permita alertas para FATNAG."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach não dispara drills enquanto estiver negado. Toca Sistema e permite alertas para FATNAG."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach nu poate lansa drill-uri cât e refuzat. Atinge Sistem, apoi permite alerte pentru FATNAG."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach не запустит drillы, пока отказано. Нажми Система, затем разреши алерты для FATNAG."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach nemôže spúšťať drilly, keď je to odmietnuté. Klepni Systém, potom povoľ upozornenia pre FATNAG."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach kan inte avfyra drills medan nekad. Tryck System, tillåt sedan aviseringar för FATNAG."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach ยิงดริลไม่ได้ตอนถูกปฏิเสธ แตะระบบ แล้วอนุญาตการแจ้งเตือนให้ FATNAG"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reddediliyken Coach drill ateşleyemez. Sistem’e dokun, sonra FATNAG için uyarılara izin ver."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach не запустить drillи, поки відмовлено. Торкнись Система, потім дозволь сповіщення для FATNAG."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach không bắn drill khi bị từ chối. Chạm Hệ thống, rồi cho phép cảnh báo cho FATNAG."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被拒绝时，教练不能进行消防演习。轻触“系统” ，然后启用FATNAG警报。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "被拒絕時 Coach 無法發起訓練。點系統，然後允許 FATNAG 提醒。"
          }
        }
      }
    },
