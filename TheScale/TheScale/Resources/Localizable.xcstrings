    "settings.watch_mirror.help": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "fatnag alerts mirror to Apple Watch when Mirror iPhone Alerts is on for fatnag in the Watch app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes fatnag se mirent sur l’Apple Watch si « Miroir des alertes iPhone » est activé pour fatnag dans l’app Watch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Watchアプリでfatnagの「iPhoneアラートをミラー」がオンなら、アラートがApple Watchにも出ます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنبيهات fatnag تنعكس على Apple Watch عندما يكون Mirror iPhone Alerts مفعّلًا لـ fatnag في تطبيق Watch."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "fatnag emet alertes a l'Apple Watch quan Mirror iPhone Alerts està activat per a fatnag a l'aplicació Watch."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornění fatnag se zrcadlí na Apple Watch, když je Mirror iPhone Alerts zapnuté pro fatnag v aplikaci Watch."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "fatnag-advarsler spejles til Apple Watch, når Spejl iPhone-advarsler er til for fatnag i Watch-appen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "fatnag-Hinweise spiegeln auf die Apple Watch, wenn „iPhone-Mitteilungen spiegeln“ für fatnag in der Watch-App an ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ειδοποιήσεις fatnag καθρεφτίζονται στο Apple Watch όταν το Mirror iPhone Alerts είναι on για fatnag στην εφαρμογή Watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alertas de fatnag se espejan en Apple Watch cuando Mirror iPhone Alerts está on para fatnag en la app Watch."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "fatnag-hälytykset peilataan Apple Watchiin kun Peilaa iPhone-hälytykset on päällä fatnagille Watch-sovelluksessa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התראות fatnag משתקפות ל־Apple Watch כש־Mirror iPhone Alerts פעיל ל־fatnag באפליקציית Watch."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch ऐप में fatnag के लिए Mirror iPhone Alerts चालू होने पर fatnag अलर्ट Apple Watch पर मिरर होते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozorenja fatnag se zrcale na Apple Watch kad je Mirror iPhone Alerts uključeno za fatnag u aplikaciji Watch."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fatnag értesítések Apple Watchra tükröződnek, ha a Mirror iPhone Alerts be van kapcsolva a fatnaghoz a Watch appban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan fatnag mencerminkan ke Apple Watch saat Mirror iPhone Alerts aktif untuk fatnag di app Watch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli avvisi fatnag si rispecchiano su Apple Watch quando Mirror iPhone Alerts è on per fatnag nell’app Watch."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "fatnag는 Watch 앱에서 Fatnag에 대해 Mirror iPhone Alerts가 켜져 있을 때 Apple Watch를 미러링합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Makluman fatnag dicerminkan ke Apple Watch bila Mirror iPhone Alerts on untuk fatnag dalam app Watch."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "fatnag-varsler speiles til Apple Watch når Speil iPhone-varsler er på for fatnag i Watch-appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "fatnag-meldingen spiegelen naar Apple Watch als Spiegel iPhone-meldingen voor fatnag aan staat in de Watch-app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerty fatnag mirrorują się na Apple Watch, gdy Mirror iPhone Alerts jest włączone dla fatnag w apce Watch."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertas do fatnag espelham no Apple Watch quando Mirror iPhone Alerts está on para fatnag no app Watch."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As alertas do fatnag espelham no Apple Watch quando Mirror iPhone Alerts está on para fatnag na app Watch."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertele fatnag se oglindesc pe Apple Watch când Mirror iPhone Alerts e on pentru fatnag în app-ul Watch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Алерты fatnag зеркалятся на Apple Watch, когда Mirror iPhone Alerts включён для fatnag в приложении Watch."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornenia fatnag sa zrkadlia na Apple Watch, keď je Mirror iPhone Alerts zapnuté pre fatnag v aplikácii Watch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "fatnag-aviseringar speglas till Apple Watch när Spegla iPhone-aviseringar är på för fatnag i Watch-appen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือน fatnag สะท้อนไป Apple Watch เมื่อเปิด Mirror iPhone Alerts สำหรับ fatnag ในแอป Watch"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch uygulamasında fatnag için Mirror iPhone Alerts açıksa fatnag uyarıları Apple Watch’a yansır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення fatnag дзеркаляться на Apple Watch, коли Mirror iPhone Alerts увімкнено для fatnag у застосунку Watch."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảnh báo fatnag phản chiếu sang Apple Watch khi Mirror iPhone Alerts bật cho fatnag trong app Watch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当在手表应用程序中打开Mirror iPhone Alerts for fatnag时， fatnag会提醒镜像到Apple Watch。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Watch App 中為 fatnag 打開「鏡像 iPhone 提醒」時，fatnag 提醒會鏡像到 Apple Watch。"
          }
        }
      }
    },
