    "subscription.thanks.feedback" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The feedback form is in Settings. A bug, an idea, or a note about what you love — we read it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El formulario de comentarios está en Ajustes. Un fallo, una idea o una nota sobre lo que te gusta: lo leemos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le formulaire d’avis est dans Réglages. Un bug, une idée ou un mot sur ce que tu aimes — on le lit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Feedbackformular ist in den Einstellungen. Ein Fehler, eine Idee oder eine Notiz zu dem, was du magst — wir lesen es."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il modulo di feedback è in Impostazioni. Un bug, un’idea o una nota su ciò che ami — lo leggiamo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O formulário de feedback está em Ajustes. Um bug, uma ideia ou uma nota sobre o que você ama — nós lemos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O formulário de feedback está nas Definições. Um erro, uma ideia ou uma nota sobre o que gostas — nós lemos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィードバックは設定にあります。不具合、アイデア、好きな点。読みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "피드백 양식은 설정에 있습니다. 버그, 아이디어, 좋은 점. 읽습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反馈表在设置里。缺陷、想法，或你喜欢的地方，我们都会读。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "意見表在設定裡。缺陷、想法，或你喜歡的地方，我們都會讀。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het feedbackformulier staat in Instellingen. Een bug, een idee of een noot over wat je fijn vindt — we lezen het."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feedbackformuläret finns i Inställningar. En bugg, en idé eller en rad om det du gillar — vi läser den."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feedbackformularen ligger i Indstillinger. En fejl, en idé eller en note om det du kan lide — vi læser den."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palautelomake on asetuksissa. Bugi, idea tai huomio siitä mistä pidät — luemme sen."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilbakemeldingsskjemaet er i Innstillinger. En feil, en idé eller et notat om det du liker — vi leser det."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formularz opinii jest w Ustawieniach. Błąd, pomysł albo notka o tym, co lubisz — czytamy."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geri bildirim formu Ayarlar’da. Bir hata, bir fikir veya sevdiğin şey hakkında bir not — okuruz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Форма отзыва в Настройках. Баг, идея или заметка о том, что тебе нравится — мы это читаем."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نموذج الملاحظات في الإعدادات. خلل أو فكرة أو ملاحظة عما تحب — نقرأها."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ीडबैक फ़ॉर्म सेटिंग्स में है। बग, विचार, या जो पसंद है उस पर नोट — हम पढ़ते हैं।"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แบบฟอร์มความคิดเห็นอยู่ในการตั้งค่า บั๊ก ไอเดีย หรือโน้ตว่าชอบอะไร เราอ่าน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mẫu phản hồi nằm trong Cài đặt. Một lỗi, một ý, hoặc ghi chú về điều bạn thích — chúng tôi đọc."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formulir masukan ada di Pengaturan. Bug, ide, atau catatan tentang yang kamu suka — kami membacanya."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borang maklum balas ada dalam Tetapan. Pepijat, idea atau nota tentang apa yang anda suka — kami membacanya."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "טופס המשוב נמצא בהגדרות. באג, רעיון או הערה על מה שאתה אוהב — אנחנו קוראים."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Форма відгуку в Налаштуваннях. Баг, ідея чи нотатка про те, що тобі подобається — ми читаємо."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formulář zpětné vazby je v Nastavení. Chyba, nápad nebo poznámka k tomu, co máš rád — čteme to."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η φόρμα σχολίων είναι στις Ρυθμίσεις. Ένα σφάλμα, μια ιδέα ή μια σημείωση για ό,τι αγαπάς — το διαβάζουμε."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A visszajelző űrlap a Beállításokban van. Egy hiba, egy ötlet vagy egy jegyzet arról, amit szeretsz — elolvassuk."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formularul de feedback e în Setări. Un bug, o idee sau o notă despre ce-ți place — o citim."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formulár spätnej väzby je v Nastaveniach. Chyba, nápad alebo poznámka k tomu, čo máš rád — čítame to."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrazac povratne informacije je u Postavkama. Greška, ideja ili bilješka o onome što voliš — čitamo."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El formulari de comentaris és a Configuració. Un error, una idea o una nota sobre el que t’agrada — ho llegim."
          }
        }
      }
    },
