            "state": "translated",
            "value": "Tinggi, berat, BF% pilihan. Unit tukar LIVE."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Høyde, vekt, valgfritt BF%. Enheter konverterer live."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wzrost, waga, opcjonalnie BF%. Jednostki przeliczają na żywo."
