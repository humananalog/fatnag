        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibt nicht in Apple Health. Körperfett % ist während der Kalibrierung nur informativ."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν γράφει στο Apple Health. Το % λίπους είναι μόνο ενημερωτικό κατά τη βαθμονόμηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Does not write to Apple Health. Body fat % is informational only during calibration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No escribe en Apple Health. El % de grasa es solo informativo durante la calibración."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei kirjoita Apple Healthiin. Rasva % on vain informatiivinen kalibroinnin aikana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
