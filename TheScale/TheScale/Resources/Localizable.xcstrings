    "onboarding.pace.refuse" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel يرفض. %.1f kg في %d يومًا تساوي نحو %.2f kg/أسبوع. الحد الآمن إلى %@ هو ~%.2f kg/أسبوع. أقرب تاريخ صادق: %@."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel diu que no. %.1f kg en %d dies són uns %.2f kg/setmana. Màxim segur fins a %@: ~%.2f kg/setmana. Data honesta més propera: %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel říká ne. %.1f kg za %d dní je asi %.2f kg/týden. Bezpečné max do %@ je ~%.2f kg/týden. Nejdřívší poctivé datum: %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel siger nej. %.1f kg på %d dage er ca. %.2f kg/uge. Sikkert max til %@ er ~%.2f kg/uge. Tidligste ærlige dato: %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel sagt nein. %.1f kg in %d Tagen sind ca. %.2f kg/Woche. Sicheres Max bis %@ ist ~%.2f kg/Woche. Ehrlichstes Datum: %@."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο Keel λέει όχι. %.1f kg σε %d μέρες είναι ~%.2f kg/εβδομάδα. Ασφαλές μέγιστο προς %@: ~%.2f kg/εβδομάδα. Ενωρίστερη τίμια ημερομηνία: %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel says no. %.1f kg in %d days is about %.2f kg/week. Safe max to %@ is ~%.2f kg/week. Earliest honest date: %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel dice que no. %.1f kg en %d días son ~%.2f kg/semana. Máximo seguro hasta %@: ~%.2f kg/semana. Fecha honesta más cercana: %@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel sanoo ei. %.1f kg %d päivässä on n. %.2f kg/vko. Turvallinen max kohteeseen %@ on ~%.2f kg/vko. Varhaisin rehellinen päivä: %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel dit non. %.1f kg en %d jours, c'est ~%.2f kg/sem. Max sûr jusqu'à %@ : ~%.2f kg/sem. Date honnête au plus tôt : %@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel אומר לא. %.1f kg ב-%d ימים הם כ-%.2f kg/שבוע. מקס בטוח ל-%@ הוא ~%.2f kg/שבוע. תאריך כן קרוב: %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel ना कहता है। %.1f kg %d दिनों में लगभग %.2f kg/सप्ताह है। %@ तक सुरक्षित अधिकतम ~%.2f kg/सप्ताह है। शीघ्रतम ईमानदार तारीख़: %@।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel kaže ne. %.1f kg u %d dana je oko %.2f kg/tjedan. Siguran max do %@ je ~%.2f kg/tjedan. Najraniji pošten datum: %@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel nemet mond. %.1f kg %d nap alatt kb. %.2f kg/hét. Biztonságos max %@-ig ~%.2f kg/hét. Legkorábbi őszinte dátum: %@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel bilang tidak. %.1f kg dalam %d hari sekitar %.2f kg/minggu. Maks aman ke %@ ~%.2f kg/minggu. Tanggal jujur terdekat: %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel dice no. %.1f kg in %d giorni sono circa %.2f kg/settimana. Max sicuro fino a %@: ~%.2f kg/settimana. Data onesta più vicina: %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keelがノー。%.1f kgを%d日で約%.2f kg/週。%@までの安全な最大は ~%.2f kg/週。最短の正直な日付: %@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel이 거절. %.1f kg을 %d일에 약 %.2f kg/주. %@까지 안전 최대 ~%.2f kg/주. 가장 빠른 정직한 날짜: %@."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel kata tak. %.1f kg dalam %d hari lebih kurang %.2f kg/minggu. Maks selamat ke %@ ialah ~%.2f kg/minggu. Tarikh jujur terdekat: %@."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel sier nei. %.1f kg på %d dager er ca. %.2f kg/uke. Trygt max til %@ er ~%.2f kg/uke. Tidligste ærlige dato: %@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel zegt nee. %.1f kg in %d dagen is ongeveer %.2f kg/week. Veilig max tot %@ is ~%.2f kg/week. Vroegste eerlijke datum: %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel mówi nie. %.1f kg w %d dni to ok. %.2f kg/tydz. Bezpieczne max do %@ to ~%.2f kg/tydz. Najwcześniejsza uczciwa data: %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel diz não. %.1f kg em %d dias é ~%.2f kg/semana. Máx seguro até %@ é ~%.2f kg/semana. Data honesta mais próxima: %@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Keel diz não. %.1f kg em %d dias é ~%.2f kg/semana. Máx seguro até %@ é ~%.2f kg/semana. Data honesta mais próxima: %@."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel spune nu. %.1f kg în %d zile e ~%.2f kg/săptămână. Max sigur până %@ e ~%.2f kg/săptămână. Cea mai timpurie dată onestă: %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel говорит нет. %.1f кг за %d дней это ~%.2f кг/нед. Безопасный max до %@ ~%.2f кг/нед. Самая ранняя честная дата: %@."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel hovorí nie. %.1f kg za %d dní je ~%.2f kg/týždeň. Bezpečné max do %@ je ~%.2f kg/týždeň. Najskorší úprimný dátum: %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel säger nej. %.1f kg på %d dagar är ca %.2f kg/vecka. Säkert max till %@ är ~%.2f kg/vecka. Tidigaste ärliga datum: %@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel ปฏิเสธ %.1f kg ใน %d วัน คือประมาณ %.2f kg/สัปดาห์ สูงสุดปลอดภัยถึง %@ คือ ~%.2f kg/สัปดาห์ วันที่ซื่อสัตย์เร็วสุด: %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel hayır diyor. %.1f kg'ı %d günde yaklaşık %.2f kg/hafta. %@'ya güvenli maks ~%.2f kg/hafta. En erken dürüst tarih: %@."
          }
