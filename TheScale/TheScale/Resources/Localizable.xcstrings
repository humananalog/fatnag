    "live.cal.no_health" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يكتب إلى Apple Health. نسبة الدهون معلوماتية فقط أثناء المعايرة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No escriu a Apple Health. El % de greix corporal només és informatiu durant la calibració."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
