          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Keel สำหรับแชท การ์ดจันทร์ เช็กฟิต และแผนมื้อ Coach บนเครื่องไม่จำกัด รีเซ็ตวันจันทร์"
