    "plan.pro.blurb": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلا سقف ناعم. %d رصيد Keel live أسبوعيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine weiche Decke. %d Live-Keel-Credits pro Woche."
