        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वज़न स्ट्रीम हो रहा है। स्केल स्कैन खत्म करने के बाद बॉडी फैट %।"
          }
        },
        "hr" : {
