        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abos laufen über Apple. Stelle wieder her, wenn du Plus oder Pro schon mit dieser Apple-ID gekauft hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι συνδρομές περνούν από την Apple. Επανάφερε αν έχεις ήδη αγοράσει Plus ή Pro με αυτό το Apple ID."
          }
        },
        "en" : {
