    "live.cal.hint" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضع تلك الكتلة على المنصة — حافي القدمين اختياري. الـ Live كغ أدناه قراءة خام من الميزان. احفظ عندما تستقر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Col·loca aquesta massa descalç-opcional a la plataforma. Els kg vius de sota són en brut de l'escala. Emmagatzemar quan s'assenta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postav tu hmotu na platformu — bosé nohy volitelné. Live kg níže je syrový údaj z váhy. Ulož, až se ustálí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt massen barfodet-valgfrit på platformen. Live-kg nedenfor er rå fra vægten. Gem, når den stabiliserer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Masse barfuß-optional auf die Plattform. Live-kg unten ist Rohwert von der Waage. Speichern, wenn es sich einpendelt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάλε αυτή τη μάζα στην πλατφόρμα — ξυπόλητος προαιρετικά. Το Live kg κάτω είναι ακατέργαστο από τη ζυγαριά. Αποθήκευσε όταν σταθεροποιηθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place that mass barefoot-optional on the platform. Live kg below is raw from the scale. Store when it settles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon esa masa (pies descalzos opcional) en la plataforma. Los kg LIVE abajo son crudos de la báscula. Guarda cuando se estabilice."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aseta massa paljain jaloin -valinnaisesti alustalle. Live-kg alla on raaka vaa'asta. Tallenna kun se asettuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pose cette masse sur le plateau. Le kg live ci-dessous est brut depuis la balance. Enregistre quand c’est stable."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שים את המסה על הפלטפורמה — יחף אופציונלי. ה־Live ק\"ג למטה הוא גולמי מהמשקל. שמור כשמתייצב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उस द्रव्यमान को प्लेटफ़ॉर्म पर रखें (बिना जूते वैकल्पिक)। नीचे LIVE kg स्केल से कच्चा है। स्थिर होने पर स्टोर करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stavi tu masu na platformu — boso opcionalno. Live kg ispod je sirovo s vage. Spremi kad se stabilizira."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tedd azt a tömeget a platformra — mezítláb opcionális. Az alábbi Live kg nyers a mérlegről. Tárold, ha stabilizálódik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letakkan massa di platform (boleh tanpa sepatu). kg LIVE di bawah mentah dari timbangan. Simpan saat stabil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti quella massa (piedi scalzi opzionale) sulla piattaforma. I kg LIVE sotto sono grezzi dalla bilancia. Salva quando si stabilizza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その質量をプラットフォームに載せて。下のライブkgはスケール生値。安定したら保存。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "맨발 옵션 덩어리를 플랫폼에 놓습니다. 아래 활성 kg은 눈금에서 원시입니다. 정착하면 보관하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letak jisim itu di platform — kaki kosong pilihan. kg LIVE di bawah mentah dari penimbang. Simpan bila stabil."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sett massen barfot-valgfritt på plattformen. Live-kg nedenfor er rå fra vekten. Lagre når den stabiliserer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet die massa (blootsvoets optioneel) op het platform. Live kg hieronder is rauw van de weegschaal. Bewaar als het stabiliseert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postaw tę masę na platformie — boso opcjonalnie. Live kg poniżej to surowy odczyt z wagi. Zapisz, gdy się ustabilizuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque essa massa (pés descalços opcional) na plataforma. Os kg LIVE abaixo são brutos da balança. Salve quando estabilizar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca essa massa (pés descalços opcional) na plataforma. Os kg LIVE abaixo são brutos da balança. Guarda quando estabilizar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pune masa aia (bosanci opțional) pe platformă. kg LIVE de jos e brut de pe cântar. Salvează când se stabilizează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поставь эту массу на платформу — босиком по желанию. Live кг ниже — сырой отсчёт с весов. Сохрани, когда устаканится."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postav tú hmotu na platformu — bosé nohy voliteľné. Live kg nižšie je surový údaj z váhy. Ulož, keď sa ustáli."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sätt massan barfota-valfritt på plattformen. Live-kg nedan är råvärde från vågen. Spara när det stabiliserats."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วางน้ำหนักบนแท่น (เท้าเปล่าได้) ค่า kg สดด้านล่างมาจากตาชั่งดิบ บันทึกเมื่อนิ่ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O kütleyi platforma koy — çıplak ayak isteğe bağlı. Aşağıdaki Live kg tartıdan ham. Otursun, sonra kaydet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Постав цю масу на платформу — босоніж за бажанням. Live кг нижче — сирий відлік із вагів. Збережи, коли усталиться."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt khối lượng lên bàn (có thể chân trần). kg LIVE bên dưới là thô từ cân. Lưu khi ổn định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将该块光脚放置在平台上（可选）。下面的活体公斤是从秤上原始的。结算后存放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把質量放到秤台（可不穿鞋）。下方 Live kg 是秤的原始值。穩定後儲存。"
          }
        }
      }
    },
