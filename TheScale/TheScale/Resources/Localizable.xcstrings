    "paywall.subhead": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Keel عندما تلين. Pro هو مسار الضغط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Keel, wenn du weich wirst. Pro ist der Druckpfad."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Keel when you go soft. Pro is the pressure path."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Keel LIVE cuando te ablandes. Pro es la vía de presión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keel live quand tu faiblis. Pro, c’est la voie de la pression."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Keel LIVE quando molli. Pro è la via della pressione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "弱くなったらライブKeel。Proは圧力の道。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "헐렁해지면 Live Keel. Pro가 압박의 길이다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Keel als je slap wordt. Pro is het drukpad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Keel LIVE quando você amolecer. Pro é o caminho da pressão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Keel, когда мягчешь. Pro — путь давления."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你一软就上 Live Keel。Pro 是加压路线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一軟就上 Live Keel。Pro 是加壓路線。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Viu la quilla quan estiguis suau. Pro és el camí de pressió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Keel, když měkneš. Pro je cesta tlaku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Keel når du bliver blød. Pro er trykstien."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Keel όταν μαλακώνεις. Το Pro είναι η διαδρομή πίεσης."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Keel kun pehmenet. Pro on painepolku."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Keel כשאתה מתרכך. Pro הוא נתיב הלחץ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब नरम पड़ो तो Live Keel। Pro दबाव का रास्ता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Keel kad omekšaš. Pro je put pritiska."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Keel, ha meglágyulsz. A Pro a nyomás útja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat kamu lembek, pakai Live Keel. Pro adalah jalur tekanan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Keel bila anda lembut. Pro ialah laluan tekanan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Keel når du blir myk. Pro er trykkstien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Keel, gdy miękniesz. Pro to ścieżka ciśnienia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Keel LIVE quando amoleceres. Pro é o caminho da pressão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Keel LIVE când te înmoi. Pro e calea de presiune."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Keel, keď mäknieš. Pro je cesta tlaku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Keel när du blir mjuk. Pro är tryckvägen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่ออ่อนแอ ใช้ Live Keel Pro คือเส้นทางกดดัน"
          }
        },
        "tr": {
          "stringUnit": {
