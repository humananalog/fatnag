    "live.weight_only.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُلتقط تركيب الجسم، لذا لن تُكتب نسبة الدهون. ما زال يمكنك تعديل الوزن قبل التأكيد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'ha capturat cap composició corporal, per la qual cosa no s'escriurà el % de greix corporal. Encara pots modificar el pes abans de confirmar-ho."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Složení těla se nezachytilo, takže % tuku se nezapíše. Váhu můžeš ještě upravit před potvrzením."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen kropssammensætning blev fanget, så kropsfedt % skrives ikke. Du kan stadig redigere vægt før bekræftelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Körperzusammensetzung erfasst, daher wird Körperfett % nicht geschrieben. Gewicht kannst du vor dem Bestätigen noch ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν καταγράφηκε σύσταση σώματος, οπότε το % λίπους δεν θα γραφτεί. Μπορείς ακόμα να επεξεργαστείς το βάρος πριν την επιβεβαίωση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No body composition was captured, so body fat % will not be written. You can still edit weight before confirming."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se capturó composición corporal, así que el % de grasa no se escribirá. Aún puedes editar el peso antes de confirmar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehonkoostumusta ei tallennettu, joten rasva %:ia ei kirjoiteta. Voit silti muokata painoa ennen vahvistusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune composition corporelle capturée : le % de graisse ne sera pas écrit. Tu peux encore modifier le poids avant de confirmer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא נתפס הרכב גוף, לכן אחוז השומן לא ייכתב. עדיין אפשר לערוך משקל לפני אישור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बॉडी कंपोज़िशन कैप्चर नहीं हुआ, इसलिए फैट % नहीं लिखा जाएगा। पुष्टि से पहले वज़न संपादित कर सकते हो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sastav tijela nije uhvaćen, pa se % masti neće zapisati. I dalje možeš urediti težinu prije potvrde."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem rögzült testösszetétel, ezért a testzsír % nem kerül mentésre. A súlyt még szerkesztheted megerősítés előtt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komposisi tubuh tidak tertangkap, jadi lemak % tidak ditulis. Masih bisa edit berat sebelum konfirmasi."
