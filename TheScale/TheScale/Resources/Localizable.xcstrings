    "notif.empty_queued_detail": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل وزن الصباح أو تذكيرات الأسبوع في الإعدادات، ثم اسحب للتحديث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Morgenwiegen oder Wochenerinnerungen in Einstellungen einschalten, dann zum Aktualisieren ziehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Morning weigh or weekly reminders in Settings, then pull to refresh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Pesaje matutino o recordatorios semanales en Ajustes, luego tira para actualizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active la pesée du matin ou les rappels hebdo dans Réglages, puis tire pour actualiser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Pesata mattutina o promemoria settimanali in Impostazioni, poi tira per aggiornare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定で朝の計量や週次リマインダーをオンにして、引っ張って更新。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 Morning weigh 또는 주간 미리 알림을 켜고 당겨 새로 고침하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet Ochtendwegen of wekelijkse herinneringen aan in Instellingen, trek dan om te vernieuwen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative Pesagem matinal ou lembretes semanais em Ajustes, depois puxe para atualizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включи утреннее взвешивание или недельные напоминания в Настройках, затем потяни обновление."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”中打开“早晨称重”或“每周提醒” ，然后下拉刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在設定中打開晨量或每週提醒，然後下拉重新整理。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el pes matinal o els recordatoris setmanals a Configuració i, a continuació, tira per actualitzar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapni ranní vážení nebo týdenní připomínky v Nastavení, pak přetáhni obnovení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå Morgenvejning eller ugentlige påmindelser til i Indstillinger, træk derefter for at opdatere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξε πρωινή ζύγιση ή εβδομαδιαίες υπενθυμίσεις στις Ρυθμίσεις, μετά τράβα ανανέωση."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota Aamupunnitus tai viikkomuistutukset käyttöön Asetuksissa, vedä sitten päivittääksesi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעל שקילת בוקר או תזכורות שבועיות בהגדרות, ואז משוך לרענון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्स में मॉर्निंग तौल या साप्ताहिक रिमाइंडर चालू करें, फिर खींचकर रीफ़्रेश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključi jutarnje vaganje ili tjedne podsjetnike u Postavkama, zatim povuci za osvježavanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be a reggeli mérést vagy a heti emlékeztetőket a Beállításokban, majd húzd a frissítést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan timbang pagi atau pengingat mingguan di Pengaturan, lalu tarik refresh."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan Morning weigh atau peringatan mingguan dalam Settings, kemudian tarik muat semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Morgenveiing eller ukentlige påminnelser i Innstillinger, trekk deretter for å oppdatere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz poranne ważenie lub tygodniowe przypomnienia w Ustawieniach, potem pociągnij, by odświeżyć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa Pesagem matinal ou lembretes semanais em Definições, depois puxa para atualizar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pornește Cântărirea de dimineață sau reminder-ele săptămânale în Setări, apoi trage pentru refresh."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapni ranné váženie alebo týždenné pripomienky v Nastaveniach, potom potiahni obnovenie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Morgonvägning eller veckopåminnelser i Inställningar, dra sedan för att uppdatera."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดชั่งเช้าหรือเตือนรายสัปดาห์ในการตั้งค่า แล้วดึงรีเฟรช"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar’da sabah tartımını veya haftalık hatırlatıcıları aç, sonra yenilemeyi çek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкни ранкове зважування або тижневі нагадування в Налаштуваннях, потім потягни оновлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật cân sáng hoặc nhắc tuần trong Cài đặt, rồi kéo làm mới."
          }
        }
      }
    },
    "notif.focus_footer": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus و«عدم الإزعاج» ما زالا قد يكتمبان اللافتات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus und Nicht stören können Banner trotzdem stumm halten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus and Do Not Disturb can still silence banners."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfoque y No molestar aún pueden silenciar los banners."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentration et Ne pas déranger peuvent encore couper les bannières."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus e Non disturbare possono ancora silenziare i banner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中モードやおやすみモードでバナーが消えることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초점 및 방해 금지는 여전히 배너를 침묵시킬 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus en Niet storen kunnen banners alsnog dempen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foco e Não Perturbe ainda podem silenciar os banners."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus и Не беспокоить всё ещё могут глушить баннеры."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“专注”和“请勿打扰”仍然可以使横幅静音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "專注模式與勿擾仍可能靜音橫幅。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfoca't i no molestis encara pot silenciar les pancartes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus a Nerušit můžou stále ztlumit bannery."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus og Forstyr ikke kan stadig dæmpe banners."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Focus και το Μην ενοχλείτε μπορούν ακόμα να σιγήσουν banners."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus ja Älä häiritse voivat silti hiljentää bannerit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus ו״נא לא להפריע״ עדיין יכולים להשתיק באנרים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus और Do Not Disturb अभी भी बैनर चुप कर सकते हैं।"
