    "settings.brand.blurb": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile, Coach, Health, and privacy — all on this iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil, Coach, Santé et confidentialité — tout sur cet iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィール、コーチ、ヘルスケア、プライバシー — すべてこのiPhone上。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملف وCoach وHealth والخصوصية — كلها على هذا الـ iPhone."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfil, entrenador, salut i privacitat, tot en aquest iPhone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil, Coach, Health a soukromí — vše na tomto iPhonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil, Coach, Health og privatliv — alt på denne iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil, Coach, Health und Datenschutz — alles auf diesem iPhone."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προφίλ, Coach, Health και απόρρητο — όλα σε αυτό το iPhone."
