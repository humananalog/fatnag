    "Age %lld+ required. Full copies stay in Settings → Privacy & Legal." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Age %lld+ required. Full copies stay in Settings → Privacy & Legal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se requiere %lld años o más. Los textos completos están en Ajustes → Privacidad y legal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il faut %lld ans ou plus. Les textes complets sont dans Réglages → Confidentialité et mentions légales."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindestens %lld Jahre. Die vollständigen Texte stehen unter Einstellungen → Datenschutz & Rechtliches."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servono %lld anni o più. I testi completi sono in Impostazioni → Privacy e note legali."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É preciso ter %lld anos ou mais. Os textos completos ficam em Ajustes → Privacidade e jurídico."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É preciso ter %lld anos ou mais. Os textos completos ficam em Definições → Privacidade e legal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 歳以上が必要です。全文は設定 → プライバシーと法務にあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld세 이상이어야 합니다. 전문은 설정 → 개인정보 및 법적 고지에 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "须年满 %lld 岁。全文在设置 → 隐私与法律信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "須年滿 %lld 歲。全文在設定 → 隱私與法律資訊。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimaal %lld jaar. De volledige teksten staan in Instellingen → Privacy en juridisch."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minst %lld år. De fullständiga texterna finns i Inställningar → Integritet och juridiskt."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindst %lld år. De fulde tekster ligger i Indstillinger → Privatliv og juridisk."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vähintään %lld vuotta. Täydet tekstit ovat kohdassa Asetukset → Tietosuoja ja oikeudellista."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minst %lld år. De fulle tekstene ligger i Innstillinger → Personvern og juridisk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymagane %lld lat. Pełne teksty są w Ustawienia → Prywatność i prawne."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En az %lld yaş. Tam metinler Ayarlar → Gizlilik ve yasal bölümünde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужно %lld лет или больше. Полные тексты в Настройках → Конфиденциальность и правовое."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يلزم عمر %lld فأكثر. النصوص الكاملة في الإعدادات → الخصوصية والقانوني."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld+ वर्ष ज़रूरी। पूरा पाठ सेटिंग्स → गोपनीयता और कानूनी में है।"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องมีอายุ %lld ปีขึ้นไป ข้อความฉบับเต็มอยู่ในการตั้งค่า → ความเป็นส่วนตัวและกฎหมาย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cần từ %lld tuổi. Bản đầy đủ nằm ở Cài đặt → Quyền riêng tư và pháp lý."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimal %lld tahun. Teks lengkap ada di Pengaturan → Privasi dan hukum."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimum %lld tahun. Teks penuh ada di Tetapan → Privasi dan undang-undang."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נדרש גיל %lld ומעלה. הנוסח המלא בהגדרות → פרטיות ומשפטי."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потрібно %lld років або більше. Повні тексти в Налаштуваннях → Конфіденційність і правове."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je třeba %lld let a víc. Úplná znění jsou v Nastavení → Soukromí a právní."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απαιτούνται %lld έτη και άνω. Τα πλήρη κείμενα είναι στις Ρυθμίσεις → Απόρρητο και νομικά."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legalább %lld év. A teljes szövegek a Beállítások → Adatvédelem és jogi részen vannak."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este nevoie de %lld ani sau mai mult. Textele complete sunt în Setări → Confidențialitate și juridic."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treba %lld rokov a viac. Úplné znenia sú v Nastaveniach → Súkromie a právne."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrebno je %lld godina ili više. Puni tekstovi su u Postavkama → Privatnost i pravno."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cal tenir %lld anys o més. Els textos complets són a Configuració → Privadesa i legal."
          }
        }
      }
    },
