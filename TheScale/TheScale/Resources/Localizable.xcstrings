    "Web links open our public Privacy Policy and Terms. Full copies also live in Settings above." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روابط الويب تفتح سياسة الخصوصية والشروط العامة. النسخ الكاملة موجودة أيضًا أعلاه في الإعدادات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els enllaços web obren la Política de privadesa i els Termes públics. Les còpies completes també són a dalt, a Configuració."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Webové odkazy otevřou veřejné Zásady soukromí a Podmínky. Úplná znění jsou i výše v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weblinks åbner vores offentlige privatlivspolitik og vilkår. De fulde tekster ligger også ovenfor i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weblinks öffnen unsere öffentliche Datenschutzrichtlinie und die Bedingungen. Die vollständigen Texte stehen auch oben in den Einstellungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι σύνδεσμοι ανοίγουν τη δημόσια Πολιτική απορρήτου και τους Όρους. Τα πλήρη κείμενα είναι και παραπάνω στις Ρυθμίσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web links open our public Privacy Policy and Terms. Full copies also live in Settings above."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los enlaces web abren nuestra Política de privacidad y los Términos públicos. Las copias completas también están arriba en Ajustes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verkkolinkit avaavat julkisen tietosuojakäytännön ja ehdot. Täydet tekstit ovat myös yllä asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les liens web ouvrent notre Politique de confidentialité et nos Conditions publiques. Les textes complets sont aussi plus haut dans Réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קישורי האתר פותחים את מדיניות הפרטיות והתנאים הפומביים. הנוסח המלא גם למעלה בהגדרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वेब लिंक हमारी सार्वजनिक गोपनीयता नीति और शर्तें खोलते हैं। पूरी प्रतियाँ ऊपर सेटिंग्स में भी हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web poveznice otvaraju javna Pravila privatnosti i Uvjete. Puni tekstovi su i gore u Postavkama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A webes linkek a nyilvános Adatvédelmi irányelvet és a Feltételeket nyitják. A teljes szövegek fent a Beállításokban is megvannak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tautan web membuka Kebijakan Privasi dan Ketentuan publik. Salinan lengkap juga ada di atas, di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I link web aprono l’Informativa privacy e i Termini pubblici. I testi completi sono anche sopra, in Impostazioni."
