    "settings.calibration.help": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter true mass, open the live sheet, weigh, then store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre la vraie masse, ouvre la feuille live, pèse, puis enregistre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "真の質量を入力し、ライブシートを開いて計量し、保存。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل الكتلة الحقيقية، افتح ورقة Live، وزّن، ثم احفظ."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduïu la massa veritable, obriu el full viu, pesseu i, a continuació, emmagatz"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadej skutečnou hmotnost, otevři live sheet, zvaž, ulož."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast sand masse, åbn live-arket, vej, gem derefter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wahre Masse eingeben, Live-Sheet öffnen, wiegen, dann speichern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισήγαγε πραγματική μάζα, άνοιξε live sheet, ζυγίσου, αποθήκευσε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce la masa real, abre la hoja LIVE, pésate y guarda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syötä oikea massa, avaa live-arkki, punnitse, tallenna sitten."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזן מסה אמיתית, פתח live sheet, שקול, ואז שמור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सही द्रव्यमान दर्ज करें, लाइव शीट खोलें, तौलें, फिर स्टोर करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesi stvarnu masu, otvori live sheet, izvagu, spremi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add meg a valódi tömeget, nyisd a live sheetet, mérj, majd tárold."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan massa benar, buka sheet live, timbang, lalu simpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci la massa vera, apri il foglio LIVE, pesati e salva."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 질량을 입력하고, 라이브 시트를 열고, 무게를 측정한 다음, 보관하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan jisim benar, buka helaian LIVE, timbang, kemudian simpan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn sann masse, åpne live-arket, vei, lagre deretter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer echte massa in, open het live-blad, weeg, bewaar dan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj prawdziwą masę, otwórz live sheet, zważ, zapisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite a massa real, abra a folha LIVE, pese e salve."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduz a massa real, abre a folha LIVE, pesa e guarda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdu masa reală, deschide foaia LIVE, cântărește, apoi salvează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введи истинную массу, открой live sheet, взвесься, сохрани."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadaj skutočnú hmotnosť, otvor live sheet, odvaž, ulož."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange sann massa, öppna live-arket, väg, spara sedan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่มวลจริง เปิดชีตสด ชั่ง แล้วบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerçek kütleyi gir, live sheet’i aç, tartıl, kaydet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введи справжню масу, відкрий live sheet, зважся, збережи."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập khối lượng thật, mở sheet live, cân, rồi lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入真实质量，打开活页，称重，然后储存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入真實質量，打開 live 表單，量體重，然後儲存。"
          }
        }
      }
    },
