    "settings.units.help" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوزن والطول والحصص وخطة الوجبات وCoach يستخدمون هذا. Health يبقى متريًا تحت الغطاء."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El pes, l'alçada, les porcions, el pla de menjar i l'entrenador ho fan servir. Mètrica d'estades sanitàries sota el capó."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váha, výška, porce, jídelní plán a Coach to používají. Health pod kapotou zůstává metrický."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vægt, højde, portioner, måltidsplan og Coach bruger dette. Health forbliver metrisk under motorhjelmen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewicht, Größe, Portionen, Essensplan und Coach nutzen das. Health bleibt unter der Haube metrisch."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάρος, ύψος, μερίδες, πλάνο γευμάτων και Coach το χρησιμοποιούν. Το Health κάτω από το καπό μένει μετρικό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weight, height, portions, meal plan, and Coach use this. Health stays metric under the hood."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peso, altura, porciones, plan de comidas y Coach usan esto. Health se queda métrico por debajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paino, pituus, annokset, ateriasuunnitelma ja Coach käyttävät tätä. Health pysyy metrisenä konepellin alla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poids, taille, portions, plan repas et Coach suivent ça. Santé reste métrique en coulisse."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משקל, גובה, מנות, תוכנית ארוחות ו־Coach משתמשים בזה. Health נשאר מטרי מתחת למכסה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वज़न, ऊंचाई, पोर्शन, मील प्लान और Coach इसे उपयोग करते हैं। Health अंदर मीट्रिक रहता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Težina, visina, porcije, plan obroka i Coach koriste ovo. Health ispod haube ostaje metrički."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Súly, magasság, adagok, étkezési terv és Coach ezt használja. A Health a motorháztető alatt metrikus marad."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berat, tinggi, porsi, rencana makan, dan Coach memakai ini. Health tetap metrik di balik layar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peso, altezza, porzioni, piano pasti e Coach usano questo. Health resta metrico sotto il cofano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体重・身長・分量・食事プラン・コーチがこれに従う。ヘルスケアは裏でメートル法。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "체중, 키, 부분, 식사 계획, 코치가 이를 사용합니다. 건강은 후드 아래에서 메트릭을 유지합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berat, tinggi, bahagian, pelan makanan, dan Coach guna ini. Health kekal metrik di belakang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vekt, høyde, porsjoner, måltidsplan og Coach bruker dette. Health forblir metrisk under panseret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewicht, lengte, porties, maaltijdplan en Coach gebruiken dit. Health blijft onder de motorkap metrisch."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waga, wzrost, porcje, plan posiłków i Coach używają tego. Health pod spodem zostaje metryczny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peso, altura, porções, plano de refeições e Coach usam isto. Health fica métrico por baixo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peso, altura, porções, plano de refeições e Coach usam isto. Health fica métrico por baixo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greutate, înălțime, porții, plan de mese și Coach folosesc asta. Health rămâne metric sub capotă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вес, рост, порции, план питания и Coach используют это. Health под капотом остаётся метрическим."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váha, výška, porcie, jedálny plán a Coach to používajú. Health pod kapotou zostáva metrický."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vikt, längd, portioner, måltidsplan och Coach använder detta. Health förblir metriskt under huven."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "น้ำหนัก ส่วนสูง ส่วน มื้อ และ Coach ใช้หน่วยนี้ Health ยังเมตริกข้างใน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağırlık, boy, porsiyonlar, öğün planı ve Coach bunu kullanır. Health kaput altında metrik kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вага, зріст, порції, план харчування й Coach використовують це. Health під капотом лишається метричним."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cân, chiều cao, khẩu phần, kế hoạch bữa và Coach dùng cái này. Health vẫn metric bên dưới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体重、身高、份量、膳食计划和教练都使用这个。健康始终是引擎盖下的指标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
