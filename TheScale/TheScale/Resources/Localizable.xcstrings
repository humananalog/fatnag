    "settings.ai.usage.help" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Keel للدردشة وبطاقة الاثنين وفحوصات اللياقة وخطط الوجبات. Coach على الجهاز بلا حد. يُعاد الاثنين."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Keel per al xat, la targeta de dilluns, les comprovacions d'aptitud física i els plans de menjar. On-device Coach s'allotja de manera il·limitada. Restaura el dilluns."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Keel pro chat, pondělní kartu, fitness checky a jídelní plány. Coach na zařízení bez limitu. Reset v pondělí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Keel til chat, mandagskort, fitnesschecks og måltidsplaner. On-device Coach forbliver ubegrænset. Nulstilles mandag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Keel für Chat, Montagskarte, Fitness-Checks und Essenspläne. On-Device-Coach bleibt unbegrenzt. Reset montags."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Keel για chat, κάρτα Δευτέρας, fitness checks και πλάνα γευμάτων. Το on-device Coach χωρίς όριο. Επαναφορά Δευτέρα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Keel for chat, Monday card, fitness checks, and meal plans. On-device Coach stays unlimited. Resets Monday."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel LIVE para chat, tarjeta del lunes, checks de fitness y planes de comida. Coach en el dispositivo sigue ilimitado. Se reinicia el lunes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Keel chatiin, maanantain korttiin, kuntotarkistuksiin ja ateriasuunnitelmiin. Laitteella Coach pysyy rajattomana. Nollautuu maanantaina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel LIVE pour chat, carte du lundi, checks fitness et plans repas. Coach sur l’appareil reste illimité. Reset le lundi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Keel לצ׳אט, כרטיס שני, בדיקות כושר ותוכניות ארוחות. Coach במכשיר ללא הגבלה. מתאפס ביום שני."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चैट, सोमवार कार्ड, फिटनेस चेक और मील प्लान के लिए Live Keel। ऑन-डिवाइस Coach असीमित। सोमवार रीसेट।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
