    "Changing gender is a painful process, are you sure you want to do that?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيير الجنس عملية مؤلمة. هل أنت متأكد؟"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canviar el gènere és un procés dolorós. Segur que ho vols fer?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Změna pohlaví je bolestivý proces. Opravdu to chceš?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At skifte køn er en smertefuld proces. Er du sikker?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Geschlecht zu ändern ist ein schmerzhafter Prozess. Bist du sicher?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αλλαγή φύλου είναι επώδυνη διαδικασία. Σίγουρα;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changing gender is a painful process, are you sure you want to do that?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar el género es un proceso doloroso. ¿Seguro que quieres hacerlo?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sukupuolen vaihtaminen on kivulias prosessi. Oletko varma?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changer de genre est un processus douloureux. Tu es sûr de vouloir le faire ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שינוי מין הוא תהליך כואב. בטוח שאתה רוצה?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लिंग बदलना एक दर्दनाक प्रक्रिया है। क्या तुम पक्का चाहते हो?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promjena spola je bolan proces. Jesi li siguran?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nem megváltoztatása fájdalmas folyamat. Biztos vagy benne?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengubah jenis kelamin itu proses yang menyakitkan. Yakin?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiare genere è un processo doloroso. Sei sicuro di volerlo fare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "性別を変えるのは痛いプロセスです。本当にやりますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "성별을 바꾸는 건 아픈 과정입니다. 정말 하시겠어요?"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menukar jantina proses yang menyakitkan. Pasti?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å endre kjønn er en smertefull prosess. Er du sikker?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geslacht wijzigen is een pijnlijk proces. Weet je het zeker?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiana płci to bolesny proces. Na pewno?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mudar o gênero é um processo doloroso. Tem certeza?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mudar o género é um processo doloroso. Tens a certeza?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schimbarea genului e un proces dureros. Sigur vrei?"
          }
        },
        "ru" : {
