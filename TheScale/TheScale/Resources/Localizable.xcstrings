    "onboarding.sub.anatomy": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الطول، الوزن، BF% اختياري. الوحدات تتحوّل مباشرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
