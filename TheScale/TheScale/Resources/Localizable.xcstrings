    "Bug, idea, or praise — one short note. Optional email if you want a reply." : {
      "comment" : "A description of the feedback section of the settings.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خلل أو فكرة أو إطراء — ملاحظة قصيرة. البريد اختياري إذا أردت ردًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Error, idea o elogi — una nota curta. Correu opcional si vols resposta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chyba, nápad nebo pochvala — krátká poznámka. E-mail volitelně, pokud chceš odpověď."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fejl, idé eller ros — en kort note. E-mail valgfrit, hvis du vil have svar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehler, Idee oder Lob — eine kurze Notiz. E-Mail optional, wenn du eine Antwort willst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σφάλμα, ιδέα ή έπαινος — μια σύντομη σημείωση. Email προαιρετικό αν θέλεις απάντηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bug, idea, or praise — one short note. Optional email if you want a reply."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fallo, una idea o un elogio: una nota breve. Correo opcional si quieres respuesta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugi, idea tai kehu — yksi lyhyt rivi. Sähköposti valinnainen, jos haluat vastauksen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bug, idée ou compliment — une note courte. E-mail facultatif si tu veux une réponse."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "באג, רעיון או מחמאה — הערה קצרה. אימייל אופציונלי אם תרצה תשובה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बग, विचार या तारीफ़ — एक छोटी टिप्पणी। जवाब चाहिए तो ईमेल वैकल्पिक।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greška, ideja ili pohvala — kratka bilješka. E-pošta neobavezna ako želiš odgovor."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiba, ötlet vagy dicséret — egy rövid jegyzet. E-mail opcionális, ha választ szeretnél."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bug, ide, atau pujian — satu catatan pendek. Email opsional jika ingin balasan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bug, idea o elogio — una nota breve. Email facoltativa se vuoi una risposta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不具合、アイデア、ほめ言葉。短いメモで。返信が欲しいときだけメールを。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "버그, 아이디어, 칭찬. 짧은 메모 하나. 답장을 원하면 이메일은 선택."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pepijat, idea atau pujian — satu nota pendek. E-mel pilihan jika mahu balasan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feil, idé eller ros — en kort beskjed. E-post valgfritt hvis du vil ha svar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bug, idee of compliment — een korte notitie. E-mail optioneel als je antwoord wilt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Błąd, pomysł albo pochwała — krótka notka. E-mail opcjonalnie, jeśli chcesz odpowiedzi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bug, ideia ou elogio — uma nota curta. E-mail opcional se quiser resposta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erro, ideia ou elogio — uma nota curta. E-mail opcional se quiseres resposta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bug, idee sau laudă — o notă scurtă. E-mail opțional dacă vrei răspuns."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Баг, идея или похвала — короткая заметка. Почта по желанию, если нужен ответ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chyba, nápad alebo pochvala — krátka poznámka. E-mail voliteľne, ak chceš odpoveď."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugg, idé eller beröm — en kort rad. E-post valfritt om du vill ha svar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บั๊ก ไอเดีย หรือคำชม โน้ตสั้นๆ อีเมลไม่บังคับถ้าอยากได้คำตอบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hata, fikir veya övgü — kısa bir not. Yanıt istersen e-posta isteğe bağlı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Баг, ідея чи похвала — коротка нотатка. Пошта за бажанням, якщо потрібна відповідь."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lỗi, ý tưởng hoặc lời khen — một ghi chú ngắn. Email tùy chọn nếu muốn được trả lời."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缺陷、想法或夸奖，写一句就好。想收到回复再留邮箱。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缺陷、想法或誇獎，寫一句就好。想收到回覆再留郵箱。"
          }
        }
      }
    },
