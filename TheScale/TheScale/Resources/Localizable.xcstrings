    "Changing gender is a painful process, are you sure you want to do that?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changing gender is a painful process, are you sure you want to do that?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar el género es un proceso doloroso. ¿Seguro que quieres hacerlo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changer de genre est un processus douloureux. Tu es sûr de vouloir le faire ?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Geschlecht zu ändern ist ein schmerzhafter Prozess. Bist du sicher?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiare genere è un processo doloroso. Sei sicuro di volerlo fare?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mudar o gênero é um processo doloroso. Tem certeza?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mudar o género é um processo doloroso. Tens a certeza?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "性別を変えるのは痛いプロセスです。本当にやりますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "성별을 바꾸는 건 아픈 과정입니다. 정말 하시겠어요?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改性别是个痛苦的过程。确定要这么做吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改性別是個痛苦的過程。確定要這麼做嗎？"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geslacht wijzigen is een pijnlijk proces. Weet je het zeker?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att ändra kön är en smärtsam process. Är du säker?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At skifte køn er en smertefuld proces. Er du sikker?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sukupuolen vaihtaminen on kivulias prosessi. Oletko varma?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å endre kjønn er en smertefull prosess. Er du sikker?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiana płci to bolesny proces. Na pewno?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cinsiyeti değiştirmek acı veren bir süreç. Emin misin?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смена пола — болезненный процесс. Точно хочешь?"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيير الجنس عملية مؤلمة. هل أنت متأكد؟"
