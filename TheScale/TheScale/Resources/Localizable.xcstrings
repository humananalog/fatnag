    "Removes the stored scale factor and offset. Your reference mass value is kept." : {
      "comment" : "The body of a confirmation alert that appears when the user attempts to reset the scale calibration.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزيل معامل الميزان والإزاحة المحفوظين. تبقى كتلة المرجع."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treu el factor i el desplaçament desats de la bàscula. La massa de referència es conserva."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstraní uložený faktor váhy a posun. Referenční hmotnost zůstane."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner gemt skalafaktor og forskydning. Din referencemasse beholdes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt gespeicherten Skalenfaktor und Versatz. Deine Referenzmasse bleibt erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφαιρεί τον αποθηκευμένο συντελεστή και τη μετατόπιση. Η μάζα αναφοράς μένει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes the stored scale factor and offset. Your reference mass value is kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita el factor y el desfase guardados de la báscula. Se conserva tu masa de referencia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistaa tallennetun kertoimen ja siirtymän. Viitemassa säilyy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retire le facteur et le décalage enregistrés de la balance. Ta masse de référence est conservée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסיר את מקדם המשקל וההיסט השמורים. מסת הייחוס נשמרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेव किया स्केल फैक्टर और ऑफ़सेट हटाता है। संदर्भ द्रव्यमान रहता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uklanja spremljeni faktor vage i pomak. Referentna masa ostaje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Törli a mentett skálatényezőt és eltolást. A referenciatömeg megmarad."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus faktor timbangan dan ofset yang tersimpan. Massa acuan tetap ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove fattore e scostamento salvati della bilancia. La massa di riferimento resta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存したスケール係数とオフセットを消します。基準の質量は残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 저울 계수와 오프셋을 지웁니다. 기준 질량은 유지됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengalih keluar faktor penimbang dan ofset yang disimpan. Jisim rujukan kekal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner lagret skaleringsfaktor og forskyvning. Referansemassen beholdes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert de opgeslagen schaalfactor en offset. Je referentiemassa blijft bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa zapisany współczynnik i przesunięcie wagi. Masa odniesienia zostaje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
