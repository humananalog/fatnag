        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach nemôže spúšťať drilly, keď je to odmietnuté. Klepni Systém, potom povoľ upozornenia pre FATNAG."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach kan inte avfyra drills medan nekad. Tryck System, tillåt sedan aviseringar för FATNAG."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach ยิงดริลไม่ได้ตอนถูกปฏิเสธ แตะระบบ แล้วอนุญาตการแจ้งเตือนให้ FATNAG"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reddediliyken Coach drill ateşleyemez. Sistem’e dokun, sonra FATNAG için uyarılara izin ver."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach не запустить drillи, поки відмовлено. Торкнись Система, потім дозволь сповіщення для FATNAG."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach không bắn drill khi bị từ chối. Chạm Hệ thống, rồi cho phép cảnh báo cho FATNAG."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被拒绝时，教练不能进行消防演习。轻触“系统” ，然后启用FATNAG警报。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被拒絕時 Coach 無法發起訓練。點系統，然後允許 FATNAG 提醒。"
          }
        }
      }
    },
