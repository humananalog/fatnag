    "coach.consent.off" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الموافقة متوقفة حتى توافق (أو ابقَ دون اتصال)."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dóna el teu consentiment fins que estiguis d'acord (o no et connectis)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Souhlas vypnutý, dokud nesouhlasíte (nebo zůstaňte offline)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samtykke fra, indtil du accepterer (eller forbliver offline)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einwilligung aus, bis du zustimmst (oder offline bleibst)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η συγκατάθεση είναι off μέχρι να συμφωνήσεις (ή μείνε offline)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consent off until you agree (or stay offline)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consentimiento off hasta que aceptes (o quédate offline)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suostumus pois, kunnes hyväksyt (tai pysyt offline)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consentement off jusqu’à acceptation (ou reste hors ligne)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההסכמה כבויה עד שתאשר (או הישאר אופליין)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहमति बंद जब तक आप सहमत न हों (या ऑफ़लाइन रहें)।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privola isključena dok ne pristaneš (ili ostani offline)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hozzájárulás ki van kapcsolva, amíg nem fogadod el (vagy maradj offline)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persetujuan mati sampai kamu setuju (atau tetap offline)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenso off finché non accetti (o resta offline)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同意オフ（オフラインのままも可）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동의 전엔 꺼짐(또는 오프라인 유지)."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persetujuan off sehingga anda bersetuju (atau kekal offline)."
          }
