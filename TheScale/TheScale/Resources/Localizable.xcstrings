        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लिंग बदलना एक दर्दनाक प्रक्रिया है। क्या तुम पक्का चाहते हो?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเปลี่ยนเพศเป็นกระบวนการที่เจ็บปวด แน่ใจหรือไม่"
