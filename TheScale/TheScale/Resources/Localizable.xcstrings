    "live.confirm_only_hint": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط «تأكيد» يكتب إلى Apple Health. الأخطاء تبقى على هذا الـ iPhone حتى ذلك الحين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Bestätigen schreibt in Apple Health. Fehler bleiben bis dahin auf diesem iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only Confirm writes to Apple Health. Mistakes stay on this iPhone until then."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo Confirmar escribe en Apple Health. Los errores se quedan en este iPhone hasta entonces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul Confirmer écrit dans Apple Santé. Les erreurs restent sur cet iPhone jusque-là."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo Conferma scrive su Apple Health. Gli errori restano su questo iPhone fino ad allora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確定したときだけApple Healthに書きます。それまではこのiPhone内。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health에만 확인 쓰기. 그때까지 실수는 이 iPhone에 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen Bevestigen schrijft naar Apple Health. Fouten blijven tot dan op deze iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só Confirmar grava no Apple Health. Erros ficam neste iPhone até lá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только Подтвердить пишет в Apple Health. Ошибки до этого остаются на этом iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅确认写入Apple Health。在此之前，这款iPhone上的错误会一直存在。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有「確認」才寫入 Apple Health。在此之前錯誤留在本機。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només Confirma escriu a Apple Health. Els errors es queden en aquest iPhone fins llavors."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen Potvrdit zapisuje do Apple Health. Chyby zůstanou na tomto iPhonu do té doby."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun Bekræft skriver til Apple Health. Fejl bliver på denne iPhone indtil da."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο το Επιβεβαίωση γράφει στο Apple Health. Τα λάθη μένουν σε αυτό το iPhone μέχρι τότε."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain Vahvista kirjoittaa Apple Healthiin. Virheet jäävät tälle iPhonelle siihen asti."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק אישור כותב ל־Apple Health. טעויות נשארות ב־iPhone הזה עד אז."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल पुष्टि Apple Health में लिखती है। गलतियाँ तब तक इस iPhone पर रहती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo Potvrdi piše u Apple Health. Pogreške ostaju na ovom iPhoneu do tada."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a Megerősítés ír Apple Healthbe. A hibák addig ezen az iPhone-on maradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya Konfirmasi yang menulis ke Apple Health. Kesalahan tetap di iPhone ini sampai saat itu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya Sahkan yang menulis ke Apple Health. Kesilapan kekal pada iPhone ini sehingga itu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare Bekreft skriver til Apple Health. Feil blir på denne iPhonen til da."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko Potwierdź zapisuje do Apple Health. Błędy zostają na tym iPhonie do tego momentu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só Confirmar grava no Apple Health. Os erros ficam neste iPhone até lá."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar Confirmă scrie în Apple Health. Greșelile rămân pe acest iPhone până atunci."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Len Potvrdiť zapisuje do Apple Health. Chyby zostanú na tomto iPhone do vtedy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara Bekräfta skriver till Apple Health. Misstag stannar på denna iPhone tills dess."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดยืนยันเท่านั้นที่เขียนไป Apple Health ผิดพลาดอยู่บน iPhone นี้จนกว่านั้น"
