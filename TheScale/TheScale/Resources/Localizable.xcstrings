    "Blank is fine. We may ask once in a while at key moments, never every day." : {
      "comment" : "A description of the optional dietary preferences.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blank is fine. We may ask once in a while at key moments, never every day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes dejarlo en blanco. A veces preguntamos en momentos clave, nunca cada día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux laisser vide. On demande parfois, aux moments importants, jamais tous les jours."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leer ist in Ordnung. Wir fragen ab und zu in wichtigen Momenten, nie jeden Tag."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi lasciarlo vuoto. Chiediamo ogni tanto, nei momenti chiave, mai ogni giorno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode ficar em branco. Perguntamos de vez em quando, em momentos-chave, nunca todo dia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode ficar em branco. Perguntamos de vez em quando, em momentos-chave, nunca todos os dias."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空欄で大丈夫です。大事な場面でたまに聞くだけで、毎日は聞きません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비워도 됩니다. 중요한 순간에만 가끔 묻고, 매일 묻지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空也可以。我们只在关键时刻偶尔问，不会每天问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空也可以。我們只在關鍵時刻偶爾問，不會每天問。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leeg mag. We vragen af en toe op belangrijke momenten, nooit elke dag."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomt går bra. Vi frågar ibland vid viktiga tillfällen, aldrig varje dag."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomt er fint. Vi spør indimellem ved vigtige øjeblikke, aldrig hver dag."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyhjä käy. Kysymme silloin tällöin tärkeissä kohdissa, emme joka päivä."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomt er greit. Vi spør av og til ved viktige øyeblikk, aldri hver dag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puste jest w porządku. Pytamy czasem w ważnych momentach, nigdy codziennie."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boş bırakabilirsin. Ara sıra, önemli anlarda sorarız, her gün değil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно пустым. Спрашиваем иногда в важные моменты, не каждый день."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الفراغ مناسب. نسأل أحيانًا في اللحظات المهمة، وليس كل يوم."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खाली छोड़ सकते हो। कभी-कभी अहम मौकों पर पूछते हैं, हर दिन नहीं।"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เว้นว่างได้ เราถามเป็นครั้งคราวในจังหวะสำคัญ ไม่ใช่ทุกวัน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để trống cũng được. Thỉnh thoảng hỏi lúc quan trọng, không hỏi mỗi ngày."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kosong tidak apa. Kami bertanya sesekali di momen penting, tidak setiap hari."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kosong tidak mengapa. Kami bertanya sekali-sekala pada saat penting, bukan setiap hari."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר להשאיר ריק. נשאל מדי פעם ברגעים חשובים, לא כל יום."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можна порожнім. Питаємо інколи у важливі моменти, не щодня."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prázdné je v pořádku. Ptáme se občas v důležitých chvílích, ne každý den."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το κενό είναι μια χαρά. Ρωτάμε πού και πού σε σημαντικές στιγμές, ποτέ κάθε μέρα."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az üres rendben van. Néha kérdezünk fontos pillanatokban, soha nem minden nap."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Golul e în regulă. Întrebăm din când în când în momente-cheie, niciodată în fiecare zi."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prázdne je v poriadku. Pýtame sa občas v dôležitých chvíľach, nie každý deň."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prazno je u redu. Ponekad pitamo u važnim trenucima, nikad svaki dan."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En blanc està bé. Preguntem de tant en tant en moments clau, mai cada dia."
          }
        }
      }
    },
