    "settings.dream_weight.help": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the scale, then confirm. Range is BMI-safe for your height, sex, and age. Markers follow metric or imperial Units."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser la balance, puis confirme. La plage est sûre pour ton IMC selon taille, sexe et âge. Les repères suivent les Unités métriques ou impériales."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケールをドラッグして確認。身長・性別・年齢に対しBMI安全範囲。マーカーはメートル／ヤード単位に従う。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب المقياس ثم أكّد. النطاق آمن لـ BMI حسب طولك وجنسك وعمرك. العلامات تتبع الوحدات المترية أو الإمبراطورية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrossega l'escala i confirma-la. El rang és segur per a la teva alçada, sexe i edat. Els marcadors segueixen unitats mètriques o imperials."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Táhni škálu, pak potvrď. Rozsah je bezpečný pro BMI podle výšky, pohlaví a věku. Značky podle metrických nebo imperiálních jednotek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk skalaen, bekræft derefter. Intervallet er BMI-sikkert for din højde, køn og alder. Markører følger metriske eller imperiale Enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Waage ziehen, dann bestätigen. Bereich ist BMI-sicher für deine Größe, dein Geschlecht und Alter. Marker folgen metrischen oder imperialen Einheiten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρε την κλίμακα, μετά επιβεβαίωσε. Το εύρος είναι ασφαλές για BMI για ύψος, φύλο και ηλικία. Οι δείκτες ακολουθούν μετρικές ή αυτοκρατορικές Μονάδες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra la escala y confirma. El rango es seguro para BMI según tu altura, sexo y edad. Los marcadores siguen Unidades métricas o imperiales."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä vaakaa, vahvista sitten. Vaihteluväli on BMI-turvallinen pituudellesi, sukupuolellesi ja iällesi. Merkit seuraavat metrisiä tai imperialisia Yksiköitä."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרור את הסקאלה ואז אשר. הטווח בטוח ל־BMI לפי גובה, מין וגיל. הסימונים עוקבים אחרי יחידות מטריות או אימפריאליות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्केल खींचें, फिर पुष्टि करें। रेंज आपकी ऊंचाई, लिंग, उम्र के लिए BMI-सुरक्षित। मार्कर मीट्रिक या इंपीरियल इकाइयों का पालन करते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povuci skalu, zatim potvrdi. Raspon je siguran za BMI prema visini, spolu i dobi. Markeri prate metričke ili imperijalne Jedinice."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd a skálát, majd erősíts meg. A tartomány BMI-biztonságos a magasságodhoz, nemedhez és korodhoz. A jelölők a metrikus vagy imperiális Egységeket követik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret skala, lalu konfirmasi. Rentang aman BMI untuk tinggi, jenis kelamin, usia. Penanda mengikuti satuan metrik atau imperial."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina la scala, poi conferma. L’intervallo è BMI-safe per altezza, sesso ed età. I marker seguono Unità metriche o imperiali."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "눈금을 드래그한 다음 확인합니다. 체질량 지수 (BMI) 는 신장, 성별 및 연령에 안전합니다. 마커는 미터법 또는 영국 단위법을 따릅니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret skala kemudian sahkan. Julat selamat BMI untuk tinggi, jantina, dan umur. Penanda ikut unit metrik atau imperial."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra skalaen, bekreft deretter. Intervallet er BMI-trygt for høyden, kjønnet og alderen din. Markører følger metriske eller imperiale Enheter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep de schaal, bevestig dan. Bereik is BMI-veilig voor je lengte, geslacht en leeftijd. Markeringen volgen metrische of imperiale Eenheden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij skalę, potem potwierdź. Zakres jest bezpieczny dla BMI przy Twoim wzroście, płci i wieku. Znaczniki według jednostek metrycznych lub imperialnych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste a escala e confirme. A faixa é BMI-safe para sua altura, sexo e idade. Os marcadores seguem Unidades métricas ou imperiais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrasta a escala e confirma. O intervalo é BMI-safe para a tua altura, sexo e idade. Os marcadores seguem Unidades métricas ou imperiais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage scala, apoi confirmă. Intervalul e BMI-safe pentru înălțime, sex și vârstă. Marker-ele urmează Unități metrice sau imperiale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тяни шкалу, затем подтверди. Диапазон безопасен по BMI для твоего роста, пола и возраста. Маркеры по метрическим или имперским Единицам."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťahaj škálu, potom potvrď. Rozsah je bezpečný pre BMI podľa výšky, pohlavia a veku. Značky podľa metrických alebo imperiálnych jednotiek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra skalan, bekräfta sedan. Intervallet är BMI-säkert för din längd, kön och ålder. Markörer följer metriska eller imperiala Enheter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากสเกลแล้วยืนยัน ช่วงปลอดภัยตาม BMI สำหรับส่วนสูง เพศ อายุ มาร์กเกอร์ตามหน่วยเมตริกหรืออิมพีเรียล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skalanı sürükle, sonra onayla. Aralık boy, cinsiyet ve yaşa göre BMI-güvenli. İşaretler metrik veya imperial Birimleri izler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тягни шкалу, потім підтверди. Діапазон безпечний за BMI для твого зросту, статі й віку. Маркери за метричними або імперськими Одиницями."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo cân rồi xác nhận. Khoảng an toàn BMI theo chiều cao, giới tính, tuổi. Mốc theo đơn vị metric hoặc imperial."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动刻度，然后确认。范围对您的身高、性别和年龄是BMI安全的。标记遵循公制或英制单位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖動秤尺後確認。範圍按身高、性別、年齡保證 BMI 安全。標記跟隨公制或英制單位。"
          }
        }
      }
    },
