    "subscription.thanks.welcome" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome to %@. Keel has more room for you this week — %d credits. We're glad you're here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienvenido a %@. Keel tiene más sitio para ti esta semana: %d créditos. Nos alegra que estés aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienvenue dans %@. Keel a plus de place pour toi cette semaine — %d crédits. On est contents que tu sois là."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen bei %@. Keel hat diese Woche mehr Raum für dich — %d Credits. Schön, dass du da bist."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benvenuto in %@. Keel ha più spazio per te questa settimana — %d crediti. Siamo contenti che tu sia qui."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bem-vindo ao %@. O Keel tem mais espaço para você esta semana — %d créditos. Que bom que você está aqui."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bem-vindo ao %@. O Keel tem mais espaço para ti esta semana — %d créditos. Ainda bem que estás aqui."
