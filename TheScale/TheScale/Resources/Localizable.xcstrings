    "Injuries, meds, alcohol, sleep quirks. On-device Coach context only." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Injuries, meds, alcohol, sleep quirks. On-device Coach context only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lesiones, medicación, alcohol, rarezas del sueño. Solo contexto de Coach en el dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blessures, médicaments, alcool, particularités de sommeil. Contexte Coach sur l’appareil seulement."
          }
        },
        "de" : {
          "stringUnit" : {
