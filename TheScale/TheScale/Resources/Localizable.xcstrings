    "settings.ai.usage.help" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Keel للدردشة وبطاقة الاثنين وفحوصات اللياقة وخطط الوجبات. Coach على الجهاز بلا حد. يُعاد الاثنين."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Keel per al xat, la targeta de dilluns, les comprovacions d'aptitud física i els plans de menjar. On-device Coach s'allotja de manera il·limitada. Restaura el dilluns."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Keel pro chat, pondělní kartu, fitness checky a jídelní plány. Coach na zařízení bez limitu. Reset v pondělí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Keel til chat, mandagskort, fitnesschecks og måltidsplaner. On-device Coach forbliver ubegrænset. Nulstilles mandag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Keel für Chat, Montagskarte, Fitness-Checks und Essenspläne. On-Device-Coach bleibt unbegrenzt. Reset montags."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Keel για chat, κάρτα Δευτέρας, fitness checks και πλάνα γευμάτων. Το on-device Coach χωρίς όριο. Επαναφορά Δευτέρα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Keel for chat, Monday card, fitness checks, and meal plans. On-device Coach stays unlimited. Resets Monday."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel LIVE para chat, tarjeta del lunes, checks de fitness y planes de comida. Coach en el dispositivo sigue ilimitado. Se reinicia el lunes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Keel chatiin, maanantain korttiin, kuntotarkistuksiin ja ateriasuunnitelmiin. Laitteella Coach pysyy rajattomana. Nollautuu maanantaina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel LIVE pour chat, carte du lundi, checks fitness et plans repas. Coach sur l’appareil reste illimité. Reset le lundi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Keel לצ׳אט, כרטיס שני, בדיקות כושר ותוכניות ארוחות. Coach במכשיר ללא הגבלה. מתאפס ביום שני."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चैट, सोमवार कार्ड, फिटनेस चेक और मील प्लान के लिए Live Keel। ऑन-डिवाइस Coach असीमित। सोमवार रीसेट।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Keel za chat, ponedjeljnu karticu, fitness checkove i planove obroka. Coach na uređaju bez limita. Reset u ponedjeljak."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Keel chathez, hétfői kártyához, fitnesz checkekhez és étkezési tervekhez. Az on-device Coach korlátlan. Hétfőn reset."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Keel untuk chat, kartu Senin, cek kebugaran, dan rencana makan. Coach on-device tak terbatas. Reset Senin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel LIVE per chat, card del lunedì, check fitness e piani pasti. Coach sul dispositivo resta illimitato. Si resetta lunedì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャット、月曜カード、フィットネスチェック、食事プランのライブKeel。端末内コーチは無制限。月曜リセット。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채팅, 월요일 카드, 피트니스 체크, 식사 계획을 위한 라이브 Keel. 온디바이스 코치는 무제한으로 유지됩니다. 월요일에 재설정됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Keel untuk sembang, kad Isnin, semakan kecergasan, dan pelan makanan. Coach pada peranti kekal tanpa had. Set semula Isnin."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Keel for chat, mandagskort, fitnessjekker og måltidsplaner. On-device Coach forblir ubegrenset. Nullstilles mandag."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Keel voor chat, maandagkaart, fitnesschecks en maaltijdplannen. On-device Coach blijft onbeperkt. Reset maandag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Keel do czatu, karty poniedziałku, checków kondycji i planów posiłków. Coach na urządzeniu bez limitu. Reset w poniedziałek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
