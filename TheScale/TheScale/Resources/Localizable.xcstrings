    "week.mode.hardcore.cta" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بلا تسيّب. أغلق الفجوة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sense costa. Tanca el buit."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez plachtění. Zavři mezeru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen glide. Luk gapet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht gleiten. Lücke schließen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς ρολάρισμα. Κλείσε το χάσμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No coast. Close the gap."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin costa. Cierra la brecha."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei lipsumista. Sulje ero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de coast. Ferme l’écart."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בלי לזרום. סגור את הפער."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोस्ट मत करो। गैप बंद करो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez plutanja. Zatvori jaz."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs part. Zárd a rést."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jangan meluncur. Tutup celah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente coast. Chiudi il gap."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手を抜くな。差を埋めろ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안심해선 안 돼. 갭을 메워."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jangan santai. Tutup jurang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen gli. Lukk gapet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet meegliden. Dicht het gat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez luzu. Domknij lukę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem coast. Fecha o gap."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem coast. Fecha a lacuna."
          }
        },
        "ro" : {
