    "Coach reads HealthKit after permission. Third-party apps only appear if they write to Health." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach reads HealthKit after permission. Third-party apps only appear if they write to Health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach lee HealthKit tras el permiso. Las apps de terceros solo aparecen si escriben en Salud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach lit HealthKit après l’autorisation. Les apps tierces n’apparaissent que si elles écrivent dans Santé."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach liest HealthKit nach der Erlaubnis. Drittanbieter-Apps erscheinen nur, wenn sie in Health schreiben."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach legge HealthKit dopo il permesso. Le app di terzi compaiono solo se scrivono in Salute."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Coach lê o HealthKit após a permissão. Apps de terceiros só aparecem se gravarem no Saúde."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Coach lê o HealthKit após a permissão. Apps de terceiros só aparecem se escreverem no Saúde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可のあと Coach は HealthKit を読みます。他社アプリはヘルスケアに書き込んだ場合だけ表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "권한 이후 Coach가 HealthKit을 읽습니다. 타사 앱은 건강에 기록할 때만 나타납니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授权后 Coach 读取 HealthKit。第三方应用只有写入健康才会出现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授權後 Coach 讀取 HealthKit。第三方 App 只有寫入健康才會出現。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach leest HealthKit na toestemming. Apps van derden verschijnen alleen als ze naar Health schrijven."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach läser HealthKit efter tillåtelse. Tredjepartsappar syns bara om de skriver till Hälsa."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach læser HealthKit efter tilladelse. Tredjepartsapps vises kun, hvis de skriver til Sundhed."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach lukee HealthKitin luvan jälkeen. Kolmannen osapuolen apit näkyvät vain, jos ne kirjoittavat Terveyteen."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach leser HealthKit etter tillatelse. Tredjepartsapper vises bare hvis de skriver til Helse."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach czyta HealthKit po zgodzie. Aplikacje innych firm widać tylko, gdy zapisują do Zdrowia."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzin sonrası Coach HealthKit’i okur. Üçüncü taraf uygulamalar yalnızca Sağlık’a yazarsa görünür."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После разрешения Coach читает HealthKit. Чужие приложения видны, только если пишут в Здоровье."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ Coach بيانات HealthKit بعد الإذن. تطبيقات الطرف الثالث تظهر فقط إذا كتبت في الصحة."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुमति के बाद Coach HealthKit पढ़ता है। तीसरे ऐप तभी दिखते हैं जब वे स्वास्थ्य में लिखते हैं।"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หลังอนุญาต Coach จะอ่าน HealthKit แอปอื่นจะปรากฏก็ต่อเมื่อเขียนลงสุขภาพ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau khi được phép, Coach đọc HealthKit. Ứng dụng bên thứ ba chỉ hiện nếu ghi vào Sức khỏe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah izin, Coach membaca HealthKit. Aplikasi pihak ketiga hanya muncul jika menulis ke Health."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selepas kebenaran, Coach membaca HealthKit. Aplikasi pihak ketiga hanya muncul jika menulis ke Health."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach קורא את HealthKit אחרי הרשאה. אפליקציות צד שלישי מופיעות רק אם הן כותבות לבריאות."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після дозволу Coach читає HealthKit. Сторонні застосунки видно, лише якщо вони пишуть у Здоров’я."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po povolení Coach čte HealthKit. Cizí aplikace se ukážou, jen když zapisují do Zdraví."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο Coach διαβάζει το HealthKit μετά την άδεια. Εφαρμογές τρίτων εμφανίζονται μόνο αν γράφουν στην Υγεία."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engedély után a Coach olvassa a HealthKitet. A külső appok csak akkor látszanak, ha az Egészségbe írnak."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "După permisiune, Coach citește HealthKit. Aplicațiile terțe apar doar dacă scriu în Sănătate."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po povolení Coach číta HealthKit. Cudzie aplikácie sa ukážu, len keď zapisujú do Zdravia."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakon dopuštenja Coach čita HealthKit. Aplikacije trećih strana vide se samo ako pišu u Zdravlje."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach llegeix HealthKit després del permís. Les apps de tercers només apareixen si escriuen a Salut."
          }
        }
      }
    },
