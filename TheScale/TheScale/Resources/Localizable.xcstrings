        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health में नहीं लिखता। कैलिब्रेशन के दौरान बॉडी फैट % केवल जानकारी के लिए।"
          }
        },
        "hr" : {
