    "Subscriptions via Apple. Restore if you already bought Plus or Pro on this Apple ID." : {
      "comment" : "A description of the user's subscription status.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاشتراكات عبر Apple. استعدها إذا اشتريت Plus أو Pro بهذا Apple ID."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les subscripcions van per Apple. Restaura si ja has comprat Plus o Pro amb aquest Apple ID."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Předplatné jde přes Apple. Obnov, pokud jsi Plus nebo Pro už koupil s tímto Apple ID."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnementer går via Apple. Gendan, hvis du allerede har købt Plus eller Pro med dette Apple-id."
