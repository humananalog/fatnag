        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tonen blir på enheten til du samtykker til et live Keel-spørsmål."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
