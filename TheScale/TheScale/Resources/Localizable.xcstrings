            "value": "體重串流中。秤掃描完成後顯示體脂 %。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Transmissió de pes. El % de greix corporal apareix quan la balança acaba d'escanejar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váha ve STREAM. % tuku po dokončení skenu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vægt streamer. Kropsfedt % vises, når vægten er færdig med at scanne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βάρος σε STREAM. Το % λίπους μετά την ολοκλήρωση του σκαναρίσματος."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paino streamaa. Rasva % näkyy kun vaaka viimeistelee skannauksen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משקל ב־STREAM. אחוז שומן אחרי שהמשקל מסיים לסרוק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वज़न स्ट्रीम हो रहा है। स्केल स्कैन खत्म करने के बाद बॉडी फैट %।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Težina u STREAM. % masti nakon što vaga završi sken."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Súly STREAM-ben. A testzsír % a szken befejezése után jelenik meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berat streaming. Lemak % muncul setelah timbangan selesai scan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berat streaming. Lemak % muncul selepas penimbang selesai imbasan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vekt streamer. Kroppsfett % vises når vekten er ferdig med å skanne."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waga w STREAM. % tłuszczu po zakończeniu skanu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Peso em streaming. O % de gordura aparece quando a balança terminar o scan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Greutate în streaming. % grăsime apare după ce cântarul termină scanarea."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váha v STREAM. % tuku po dokončení skenu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vikt streamar. Kroppsfett % visas när vågen är klar med scanningen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "น้ำหนักกำลังสตรีม ไขมัน % หลังตาชั่งสแกนจบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağırlık STREAM’de. Yağ %, tartı taramayı bitirdikten sonra gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вага в STREAM. % жиру після завершення скану."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cân đang stream. Mỡ % hiện sau khi cân quét xong."
          }
        }
      }
    },
    "live.comp.weight_only": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وزن فقط. عدّل الكغ أعلاه؛ الدهون متوقفة حتى ينتهي مسح barefoot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Gewicht. kg oben anpassen; Körperfett bleibt aus, bis der Barfuß-Scan fertig ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weight-only. Adjust kg above; body fat stays off until the barefoot scan finishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo peso. Ajusta los kg arriba; la grasa sigue off hasta que termine el escaneo a pies descalzos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poids seul. Ajuste les kg ci-dessus ; la graisse reste off jusqu’à la fin du scan pieds nus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo peso. Regola i kg sopra; il grasso resta off finché lo scan a piedi scalzi non finisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体重のみ。上でkgを調整。素足スキャン完了まで体脂肪はオフ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체중만. 위의 kg을 조절하세요. 맨발 스캔이 완료될 때까지 체지방이 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen gewicht. Pas kg hierboven aan; vet blijft uit tot de blootsvoete scan klaar is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só peso. Ajuste os kg acima; a gordura fica off até o scan descalço terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только вес. Крути кг выше; жир выключен, пока barefoot-скан не закончится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限体重。调整公斤以上；身体脂肪保持关闭，直到赤脚扫描完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅體重。上方可調 kg；赤腳掃描完成前體脂保持關閉。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només pes. Ajusta els kg a dalt; el greix corporal romandrà apagat fins que acabi l'exploració amb els peus descalços."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen váha. Uprav kg nahoře; tuk vypnutý, dokud barefoot sken neskončí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun vægt. Juster kg ovenfor; kropsfedt forbliver fra, indtil den barfodede scan er færdig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο βάρος. Ρύθμισε kg πάνω· το λίπος off μέχρι να τελειώσει το barefoot σκανάρισμα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain paino. Säädä kg yllä; rasva pysyy pois kunnes paljasjalkainen skannaus valmistuu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משקל בלבד. כוון ק\"ג למעלה; שומן כבוי עד שסריקת barefoot תסתיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल वज़न। ऊपर kg समायोजित करें; बिना जूते स्कैन तक फैट बंद।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo težina. Prilagodi kg gore; mast isključena dok barefoot sken ne završi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak súly. Állítsd a kg-t fent; a zsír ki van kapcsolva, amíg a barefoot szken be nem fejeződik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya berat. Sesuaikan kg di atas; lemak mati sampai scan tanpa sepatu selesai."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya berat. Laraskan kg di atas; lemak off sehingga imbasan kaki kosong selesai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare vekt. Juster kg ovenfor; kroppsfett forblir av til den barfote skannen er ferdig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko waga. Koryguj kg powyżej; tłuszcz wyłączony, aż barefoot skan skończy."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só peso. Ajusta os kg acima; a gordura fica off até o scan descalço terminar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar greutate. Ajustează kg deasupra; grăsimea rămâne off până scanarea desculț se termină."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Len váha. Uprav kg hore; tuk vypnutý, kým barefoot sken neskončí."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara vikt. Justera kg ovan; kroppsfett förblir av tills barfotascanen är klar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะน้ำหนัก ปรับ kg ด้านบน; ไขมันปิดจนกว่าสแกนเท้าเปล่าจะจบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca ağırlık. Yukarıda kg ayarla; barefoot tarama bitene kadar yağ kapalı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише вага. Крути кг вище; жир вимкнено, доки barefoot-скан не закінчиться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ cân. Chỉnh kg phía trên; mỡ tắt đến khi quét chân trần xong."
          }
        }
      }
    },
