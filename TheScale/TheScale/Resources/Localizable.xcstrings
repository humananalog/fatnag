        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'ha capturat cap composició corporal, per la qual cosa no s'escriurà el % de greix corporal. Encara pots modificar el pes abans de confirmar-ho."
          }
