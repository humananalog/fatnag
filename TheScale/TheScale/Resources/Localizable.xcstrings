        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실제 Keel 요청에 동의할 때까지 어조는 장치에 그대로 유지됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
