          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilo, Coach, Health e privacy — tutto su questo iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필, 코치, 건강 및 개인 정보 보호 — 이 iPhone에서 모두 사용할 수 있습니다."
