          "stringUnit": {
            "state": "translated",
            "value": "Sem teto mole. %d créditos Keel LIVE por semana."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без мягкого потолка. %d live кредитов Keel в неделю."
