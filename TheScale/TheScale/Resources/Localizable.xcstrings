    "live.cal.no_health" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يكتب إلى Apple Health. نسبة الدهون معلوماتية فقط أثناء المعايرة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No escriu a Apple Health. El % de greix corporal només és informatiu durant la calibració."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezapisuje do Apple Health. % tuku je při kalibraci jen informativní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriver ikke til Apple Health. Kropsfedt % er kun informativ under kalibrering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibt nicht in Apple Health. Körperfett % ist während der Kalibrierung nur informativ."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν γράφει στο Apple Health. Το % λίπους είναι μόνο ενημερωτικό κατά τη βαθμονόμηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Does not write to Apple Health. Body fat % is informational only during calibration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No escribe en Apple Health. El % de grasa es solo informativo durante la calibración."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei kirjoita Apple Healthiin. Rasva % on vain informatiivinen kalibroinnin aikana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’écrit pas dans Apple Santé. Le % de graisse est informatif pendant la calibration."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא כותב ל־Apple Health. אחוז השומן אינפורמטיבי בלבד בכיול."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health में नहीं लिखता। कैलिब्रेशन के दौरान बॉडी फैट % केवल जानकारी के लिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne piše u Apple Health. % masti je samo informativan tijekom kalibracije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem ír Apple Healthbe. A testzsír % csak informatív a kalibrálás alatt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak menulis ke Apple Health. Lemak tubuh % hanya informatif saat kalibrasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non scrive su Apple Health. Il % di grasso è solo informativo durante la calibrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Healthには書きません。校正中の体脂肪％は参考情報のみ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health에 편지를 쓰지 않습니다. 체지방 % 는 보정 중에만 정보를 제공합니다."
          }
        },
        "ms" : {
