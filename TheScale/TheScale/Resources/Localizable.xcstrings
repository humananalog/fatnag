    "paywall.cancel_note": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألغِ في أي وقت من اشتراكات App Store. يتجدد شهريًا تلقائيًا حتى تلغي قبل نهاية الفترة بـ 24 ساعة على الأقل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jederzeit in App-Store-Abos kündbar. Verlängert sich monatlich, bis du mindestens 24 Stunden vor Periodenende kündigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel anytime in App Store subscriptions. Auto-renews monthly until you cancel at least 24 hours before the period ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancela cuando quieras en suscripciones de App Store. Se renueva cada mes hasta que canceles al menos 24 horas antes de que termine el periodo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annule quand tu veux dans les abonnements App Store. Renouvellement mensuel auto jusqu’à annulation au moins 24 h avant la fin de période."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla quando vuoi negli abbonamenti App Store. Si rinnova ogni mese finché non annulli almeno 24 ore prima della fine del periodo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeのサブスクからいつでも解約可。期間終了24時間前までに解約しない限り毎月自動更新。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 구독에서 언제든지 취소할 수 있습니다. 기간이 종료되기 최소 24시간 전에 취소할 때까지 매월 자동 갱신됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Altijd opzegbaar in App Store-abonnementen. Verlengt maandelijks tot je minstens 24 uur voor het einde van de periode opzegt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancele quando quiser nas assinaturas da App Store. Renova mensalmente até você cancelar pelo menos 24 horas antes do fim do período."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменяй когда угодно в подписках App Store. Автопродление ежемесячно, пока не отменишь минимум за 24 часа до конца периода."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以在App Store订阅中随时取消。每月自动续订，直至您在周期结束前至少24小时取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可隨時在 App Store 訂閱中取消。按月自動續訂，直到你在週期結束前至少 24 小時取消。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel·la les subscripcions a l'App Store en qualsevol moment. Es renova automàticament cada mes fins que cancel·les la reserva com a mínim 24 hores abans que finalitzi el període."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zruš kdykoli v předplatných App Store. Automaticky se obnovuje měsíčně, dokud nezrušíš aspoň 24 h před koncem období."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsig når som helst i App Store-abonnementer. Fornyes månedligt, indtil du opsiger mindst 24 timer før periodens slut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακύρωσε οποιαδήποτε στιγμή στις συνδρομές App Store. Ανανεώνεται αυτόματα μηνιαία μέχρι να ακυρώσεις τουλάχιστον 24 ώρες πριν το τέλος της περιόδου."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Peru milloin tahansa App Store -tilauksista. Uusiutuu kuukausittain, kunnes peruutat vähintään 24 tuntia ennen jakson loppua."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בטל בכל עת במנויי App Store. מתחדש אוטומטית מדי חודש עד שתבטל לפחות 24 שעות לפני סוף התקופה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store सदस्यता में कभी भी रद्द करें। अवधि खत्म से कम से कम 24 घंटे पहले रद्द करने तक मासिक ऑटो-रिन्यू।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otkaži bilo kada u pretplatama App Store. Automatski se obnavlja mjesečno dok ne otkažeš barem 24 h prije kraja razdoblja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármikor lemondható az App Store előfizetéseknél. Automatikusan megújul havonta, amíg legalább 24 órával az időszak vége előtt nem mondod le."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batalkan kapan saja di langganan App Store. Perpanjang otomatis bulanan sampai dibatalkan minimal 24 jam sebelum periode berakhir."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Batalkan bila-bila dalam App Store subscriptions. Diperbaharui bulanan sehingga anda batalkan sekurang-kurangnya 24 jam sebelum tempoh tamat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avslutt når som helst i App Store-abonnementer. Fornyes månedlig til du avbryter minst 24 timer før perioden slutter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anuluj kiedy chcesz w subskrypcjach App Store. Auto-odnawianie co miesiąc, aż anulujesz co najmniej 24 h przed końcem okresu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancela quando quiseres nas subscrições da App Store. Renova mensalmente até cancelares pelo menos 24 horas antes do fim do período."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulează oricând din abonamentele App Store. Se reînnoiește lunar până anulezi cu cel puțin 24 de ore înainte de finalul perioadei."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zruš kedykoľvek v predplatných App Store. Automaticky sa obnovuje mesačne, kým nezrušíš aspoň 24 h pred koncom obdobia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avsluta när som helst i App Store-prenumerationer. Förnyas månadsvis tills du avslutar minst 24 timmar före periodens slut."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิกได้ทุกเมื่อในสมัครสมาชิก App Store ต่ออายุอัตโนมัติรายเดือนจนกว่าจะยกเลิกอย่างน้อย 24 ชม. ก่อนหมดรอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store aboneliklerinde istediğin zaman iptal et. Dönem bitmeden en az 24 saat önce iptal edene kadar aylık otomatik yenilenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасовуй будь-коли в підписках App Store. Автопродовження щомісяця, доки не скасуєш щонайменше за 24 години до кінця періоду."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy bất cứ lúc nào trong gói App Store. Tự gia hạn hàng tháng đến khi hủy ít nhất 24 giờ trước khi hết kỳ."
          }
        }
      }
    },
    "paywall.catalog_empty": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus وPro ليسا بعد في كتالوج App Store. جرّب الاستعادة، أو عُد بعد إطلاق المنتجات تحت Human Analog."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus und Pro sind noch nicht im App-Store-Katalog. Restore versuchen oder warten, bis die Produkte unter Human Analog live sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus and Pro aren’t in the App Store catalog yet. Try Restore, or check back after products go live under Human Analog."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus y Pro aún no están en el catálogo de App Store. Prueba Restaurar, o vuelve cuando los productos estén live bajo Human Analog."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus et Pro ne sont pas encore au catalogue App Store. Essaie Restaurer, ou reviens quand les produits Human Analog seront en ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus e Pro non sono ancora nel catalogo App Store. Prova Ripristina, o torna quando i prodotti saranno live sotto Human Analog."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PlusとProがまだApp Storeカタログにありません。復元を試すか、Human Analogで公開後に再確認。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus 및 Pro는 아직 App Store 카탈로그에 없습니다. 복원을 시도하거나 제품이 Human Analog 아래에서 활성화된 후 다시 확인하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus en Pro staan nog niet in de App Store-catalogus. Probeer Herstellen, of kom terug als producten live staan onder Human Analog."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus e Pro ainda não estão no catálogo da App Store. Tente Restaurar, ou volte quando os produtos estiverem live sob Human Analog."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus и Pro ещё нет в каталоге App Store. Попробуй Восстановить или зайди позже, когда продукты выйдут live под Human Analog."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus和Pro尚未出现在App Store目录中。尝试还原，或在产品上线后在Human Analog下查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus 和 Pro 尚未上架 App Store。試試回復購買，或等 Human Analog 產品上線後再來。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus i Pro encara no estan al catàleg de l'App Store. Prova Restore o torna a comprovar-ho quan els productes es publiquin a Human Analog."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus a Pro ještě nejsou v katalogu App Store. Zkus Obnovit, nebo se vrať, až produkty půjdou live pod Human Analog."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus og Pro er endnu ikke i App Store-kataloget. Prøv Gendan, eller tjek igen når produkterne er live under Human Analog."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα Plus και Pro δεν είναι ακόμα στον κατάλογο App Store. Δοκίμασε Επαναφορά ή ξανακοίτα όταν τα προϊόντα πάνε live υπό Human Analog."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus ja Pro eivät ole vielä App Store -luettelossa. Kokeile Palauta, tai tarkista uudelleen kun tuotteet ovat live Human Analogin alla."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus ו־Pro עדיין לא בקטלוג App Store. נסה שחזור, או חזור אחרי שהמוצרים יוצאים live תחת Human Analog."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus और Pro अभी App Store कैटलॉग में नहीं। Restore आज़माएँ, या Human Analog के तहत लाइव होने के बाद वापस देखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus i Pro još nisu u katalogu App Store. Pokušaj Vrati ili se vrati kad proizvodi odu live pod Human Analog."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Plus és a Pro még nincs az App Store katalógusában. Próbáld a Visszaállítást, vagy nézz vissza, ha a termékek live mennek Human Analog alatt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus dan Pro belum di katalog App Store. Coba Pulihkan, atau cek lagi setelah produk live di Human Analog."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus dan Pro belum dalam katalog App Store. Cuba Restore, atau semak semula selepas produk live di bawah Human Analog."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus og Pro er ikke i App Store-katalogen ennå. Prøv Gjenopprett, eller sjekk igjen når produktene er live under Human Analog."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus i Pro jeszcze nie ma w katalogu App Store. Spróbuj Przywróć, albo wróć, gdy produkty pójdą live pod Human Analog."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus e Pro ainda não estão no catálogo da App Store. Tenta Restaurar, ou volta quando os produtos estiverem live sob Human Analog."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus și Pro nu sunt încă în catalogul App Store. Încearcă Restaurează, sau revino după ce produsele sunt live sub Human Analog."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus a Pro ešte nie sú v katalógu App Store. Skús Obnoviť, alebo sa vráť, keď produkty pôjdu live pod Human Analog."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus och Pro finns ännu inte i App Store-katalogen. Prova Återställ, eller kolla tillbaka när produkterna är live under Human Analog."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus และ Pro ยังไม่อยู่ในแคตตาล็อก App Store ลองกู้ หรือกลับมาเมื่อสินค้าขึ้นภายใต้ Human Analog"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus ve Pro henüz App Store kataloğunda değil. Geri Yükle’yi dene veya ürünler Human Analog altında live’a geçince bak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus і Pro ще немає в каталозі App Store. Спробуй Відновити або зайди пізніше, коли продукти вийдуть live під Human Analog."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus và Pro chưa có trong catalog App Store. Thử Khôi phục, hoặc quay lại khi sản phẩm lên dưới Human Analog."
          }
        }
      }
    },
