    "paywall.annual.hint" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السنوي يثبت السنة — شهران مجانًا مقارنة بالشهري."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’anual tanca l’any — dos mesos de franc respecte del pagament mensual."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roční uzamkne rok — dva měsíce zdarma proti měsíčnímu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Årligt låser året — to måneder gratis i forhold til månedligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jährlich legt das Jahr fest — zwei Monate gratis gegenüber monatlich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ετήσιο κλειδώνει τη χρονιά — δύο μήνες δωρεάν έναντι του μηνιαίου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annual locks the year in — two months free vs paying monthly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El anual fija el año: dos meses gratis frente al pago mensual."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuositilaus lukitsee vuoden — kaksi kuukautta ilmaiseksi kuukauteen verrattuna."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’annuel verrouille l’année — deux mois offerts par rapport au mensuel."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השנתי נועל את השנה — חודשיים חינם לעומת החודשי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वार्षिक साल को लॉक करता है — मासिक से दो महीने मुफ़्त।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godišnje zaključava godinu — dva mjeseca besplatno naspram mjesečnog."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az éves lezárja az évet — két hónap ingyen a havihoz képest."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahunan mengunci setahun — dua bulan gratis dibanding bulanan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’annuale blocca l’anno: due mesi gratis rispetto al mensile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "年額はその年を固定。月額より 2 か月分お得。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연간은 한 해를 고정합니다. 월간보다 두 달이 무료."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahunan mengunci setahun — dua bulan percuma berbanding bulanan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Årlig låser året — to måneder gratis mot månedlig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaarlijks zet het jaar vast — twee maanden gratis tegenover maandelijks."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rocznie blokuje rok — dwa miesiące gratis wobec miesięcznego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O anual trava o ano — dois meses grátis em relação ao mensal."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O anual fixa o ano — dois meses grátis face ao mensal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anualul fixează anul — două luni gratuite față de plata lunară."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Годовая фиксирует год — два месяца бесплатно по сравнению с помесячной."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ročné uzamkne rok — dva mesiace zadarmo oproti mesačnému."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Årsvis låser året — två månader gratis jämfört med månadsvis."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รายปีล็อกทั้งปี ฟรีสองเดือนเมื่อเทียบกับรายเดือน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yıllık yılı kilitler — aylığa göre iki ay bedava."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Річна фіксує рік — два місяці безкоштовно проти щомісячної."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theo năm khóa cả năm — tặng hai tháng so với trả theo tháng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按年锁定这一年——比按月少付两个月。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按年鎖定這一年——比按月少付兩個月。"
          }
        }
      }
    },
