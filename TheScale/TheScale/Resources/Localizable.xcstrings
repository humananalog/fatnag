    "settings.profile.help": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device for body fat estimates, greetings, and Coach tone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur l’appareil pour les estimations de graisse, les salutations et le ton du Coach."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体脂肪推定、挨拶、コーチのトーンは端末内。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على الجهاز: تقديرات الدهون والتحيات ونبرة Coach."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En el dispositiu per a estimacions de greix corporal, salutacions i to d'entrenador."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na zařízení: odhady tuku, pozdravy a tón Coach."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På enheden til kropsfedtestimater, hilsner og Coach-tone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Gerät für Körperfett-Schätzungen, Begrüßungen und Coach-Ton."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στη συσκευή: εκτιμήσεις λίπους, χαιρετισμοί και τόνος Coach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el dispositivo para estimaciones de grasa, saludos y tono de Coach."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laitteella rasva-arvioihin, tervehdyksiin ja Coach-sävyyn."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "במכשיר: הערכות שומן, ברכות וטון Coach."
