    "No recent Health weigh. Drag the dial. Marks follow %@ only." : {
      "comment" : "A description of the onboarding view that appears when the user hasn't taken a recent weigh.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد وزن حديث في الصحة. اسحب القرص. العلامات تتبع %@ فقط."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hi ha un pes recent a Salut. Arrossega el dial. Les marques segueixen només %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve Zdraví není nedávná váha. Táhni ciferník. Značky jedou jen v %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen ny vægt i Health. Træk i skiven. Mærkerne følger kun %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein aktuelles Gewicht in Health. Zieh am Rad. Die Marken folgen nur %@."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχει πρόσφατο βάρος στην Υγεία. Σύρε τον δίσκο. Οι ενδείξεις ακολουθούν μόνο %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No recent Health weigh. Drag the dial. Marks follow %@ only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay un peso reciente en Salud. Arrastra el dial. Las marcas siguen solo %@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei tuoretta painoa Healthissa. Vedä kiekkoa. Merkit seuraavat vain yksikköä %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de poids récent dans Santé. Fais glisser le cadran. Les graduations suivent seulement %@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין שקילה אחרונה בבריאות. גרור את החוגה. הסימונים עוקבים רק אחרי %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वास्थ्य में हाल का वज़न नहीं। डायल खींचें। निशान सिर्फ़ %@ पर चलते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nema nedavne težine u Zdravlju. Povuci brojčanik. Oznake prate samo %@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs friss súly az Egészségben. Húzd a tárcsát. A jelek csak a következőt követik: %@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada timbangan baru di Health. Seret dial. Tanda hanya mengikuti %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun peso recente in Salute. Trascina la ghiera. I segni seguono solo %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルスケアに最近の体重がありません。ダイヤルをドラッグ。目盛りは %@ だけ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "건강에 최근 체중이 없습니다. 다이얼을 드래그하세요. 눈금은 %@만 따릅니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada timbangan baharu dalam Health. Seret dail. Tanda hanya ikut %@."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
