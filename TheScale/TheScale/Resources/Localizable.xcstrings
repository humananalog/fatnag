    "settings.language.help": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "واجهة التطبيق كلها. وأيضًا ردود Coach عندما يكون Live Keel مفعّلًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesamte App-UI. Auch für Coach-Antworten, wenn Live Keel an ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entire app UI. Also used for Coach replies when live Keel is on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda la UI de la app. También para respuestas de Coach cuando Keel LIVE está on."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute l’interface, le splash, et Keel. Les modèles sur l’appareil utilisent la même langue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutta l’UI dell’app. Anche per le risposte Coach quando Keel LIVE è on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ全体のUI。ライブKeel時のコーチ返信にも使用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 앱 UI. 라이브 Keel이 켜져 있을 때 Coach 응답에도 사용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hele app-UI. Ook voor Coach-antwoorden als live Keel aan staat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda a UI do app. Também para respostas do Coach quando Keel LIVE está on."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Весь UI приложения. Также ответы Coach, когда live Keel включён."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整个 App 界面。Live Keel 开启时也用于 Coach 回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整個 App 介面。Live Keel 開啟時也用於 Coach 回覆。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Interfície d'usuari d'aplicació sencera. També s'utilitza per a les respostes de l'entrenador quan la Keel en directe està activada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celé UI appky. Také odpovědi Coach, když je live Keel zapnutý."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hele app-UI. Bruges også til Coach-svar, når live Keel er til."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλο το UI της εφαρμογής. Επίσης απαντήσεις Coach όταν το live Keel είναι on."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koko sovelluksen UI. Käytetään myös Coach-vastauksiin kun live Keel on päällä."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל ממשק האפליקציה. גם תשובות Coach כש־live Keel פעיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरा ऐप UI। Live Keel चालू होने पर Coach जवाबों के लिए भी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cijeli UI app. Također odgovori Coach kad je live Keel uključen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A teljes app UI. Coach válaszokhoz is, ha a live Keel be van kapcsolva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seluruh UI app. Juga untuk balasan Coach saat Live Keel aktif."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seluruh UI app. Juga digunakan balasan Coach bila Live Keel on."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hele app-UI. Brukes også for Coach-svar når live Keel er på."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Całe UI aplikacji. Także odpowiedzi Coach, gdy live Keel jest włączony."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda a UI da app. Também para respostas do Coach quando Keel LIVE está on."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toată UI-ul app-ului. Și pentru răspunsuri Coach când Keel LIVE e on."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Celé UI appky. Aj odpovede Coach, keď je live Keel zapnutý."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hela app-UI. Används också för Coach-svar när live Keel är på."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "UI ทั้งแอป ใช้ตอบ Coach เมื่อ Live Keel เปิดด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm uygulama UI’si. Live Keel açıkken Coach yanıtları için de."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увесь UI застосунку. Також відповіді Coach, коли live Keel увімкнено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toàn bộ UI app. Cũng dùng cho trả lời Coach khi Live Keel bật."
          }
        }
      }
    },
