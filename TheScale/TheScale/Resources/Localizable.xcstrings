            "value": "إن لم تكن أنت على الميزان، تجاهل العيّنة وأعد الوزن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn das nicht du auf der Waage warst: Probe verwerfen und erneut wiegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If this was not you on the scale, discard the sample and re-weigh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no eras tú en la báscula, descarta la muestra y vuelve a pesar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ce n’était pas toi sur la balance, ignore l’échantillon et repèse-toi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se non eri tu sulla bilancia, scarta il campione e ripesa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケールの人が自分でなければサンプルを破棄して再計量。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것이 척도가 아닌 경우 샘플을 버리고 다시 계량하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als jij niet op de weegschaal stond: verwerp de meting en weeg opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se não era você na balança, descarte a amostra e re-pese."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если это был не ты на весах, отбрось пробу и взвесься снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果这不是秤上的您，请丢弃样品并重新称重。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果秤上不是你，捨棄樣本並重新量體重。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no era vostè a la balança, descarti la mostra i pesi de nou."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud to nebyl ty na váze, zahoď vzorek a zvaž se znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis det ikke var dig på vægten: kassér prøven og vej igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν δεν ήσουν εσύ στη ζυγαριά, απόρριψε το δείγμα και ξαναζυγίσου."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos et ollut sinä vaa'alla: hylkää näyte ja punnitse uudelleen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם זה לא היית אתה על המשקל, מחק את הדגימה ושקול מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर स्केल पर तुम नहीं थे, नमूना रद्द कर फिर तौलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako to nisi ti bio na vagi, odbaci uzorak i izvagu se ponovo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha nem te voltál a mérlegen, dobd el a mintát és mérj újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika bukan kamu di timbangan, buang sampel dan timbang ulang."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika bukan anda pada penimbang, buang sampel dan timbang semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis det ikke var deg på vekten: forkast prøven og vei på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli to nie Ty na wadze, odrzuć próbkę i zważ się ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se não eras tu na balança, descarta a amostra e re-pesa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă nu erai tu pe cântar, renunță la mostră și re-cântărește."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak to nebol ty na váhe, zahoď vzorku a odvaž sa znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om det inte var du på vågen: kasta provet och väg om."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าไม่ใช่คุณบนตาชั่ง ทิ้งตัวอย่างแล้วชั่งใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartıda sen değilsen örneği at ve yeniden tartıl."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо це був не ти на вагах, відкинь зразок і зважся знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu không phải bạn trên cân, bỏ mẫu và cân lại."
          }
        }
      }
    },
