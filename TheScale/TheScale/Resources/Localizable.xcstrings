    "settings.diet.help" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كيف تأكل معظم الأيام. يقود نبرة خطة الوجبات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com menges la majoria dels dies. Impulsa el to del pla d'àpats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak jíš většinu dní. Určuje tón jídelního plánu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan du spiser de fleste dage. Styrer måltidsplanens tone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie du die meisten Tage isst. Bestimmt den Ton des Essensplans."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πώς τρως τις περισσότερες μέρες. Οδηγεί τον τόνο του πλάνου γευμάτων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How you eat most days. Drives meal-plan tone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo comes la mayoría de los días. Marca el tono del plan de comidas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miten syöt useimpina päivinä. Ohjaa ateriasuunnitelman sävyä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment tu manges la plupart du temps. Oriente le ton du plan repas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "איך אתה אוכל רוב הימים. מניע את טון תוכנית הארוחות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज़्यादातर दिन कैसे खाते हो। मील-प्लान टोन चलाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kako jedeš većinu dana. Pokreće ton plana obroka."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahogy a legtöbb nap eszel. Az étkezési terv hangnemét hajtja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cara makanmu di hari biasa. Menggerakkan nada rencana makan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come mangi quasi tutti i giorni. Guida il tono del piano pasti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "普段の食べ方。食事プランのトーンに反映。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대부분의 날을 먹는 방법. 식사 계획 톤을 주도합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cara anda makan kebanyakan hari. Memacu nada pelan makanan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan du spiser de fleste dager. Styrer måltidsplanens tone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe je de meeste dagen eet. Bepaalt de toon van het maaltijdplan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak jesz na co dzień. Napędza ton planu posiłków."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
