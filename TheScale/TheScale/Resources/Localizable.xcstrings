{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "--": {
      "comment": "A placeholder text for age when it's not set.",
      "isCommentAutoGenerated": true
    },
    "·": {
      "comment": "A period.",
      "isCommentAutoGenerated": true
    },
    "%": {
      "comment": "A unit of measurement for body fat percentage.",
      "isCommentAutoGenerated": true
    },
    "%@ · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ · %@ · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$@ · %3$@"
          }
        }
      }
    },
    "%@ · %@-%@": {
      "comment": "A label that displays the intermittent fasting protocol and the eating hours.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$@-%3$@"
          }
        }
      }
    },
    "%@ / wk": {
      "comment": "A sublabel showing the rate of change of a health metric over time.",
      "isCommentAutoGenerated": true
    },
    "%@ %@": {
      "comment": "A label that combines the title and value of a daily target.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ locked": {
      "comment": "A subheading displaying the user's current weight. The argument is the user's current weight.",
      "isCommentAutoGenerated": true
    },
    "%@ now": {
      "comment": "A subheading displaying the user's current weight. The argument is the user's current weight.",
      "isCommentAutoGenerated": true
    },
    "%@ Sunday": {
      "comment": "A label that shows the unit of measurement for weight.",
      "isCommentAutoGenerated": true
    },
    "%@ this week": {},
    "%lld": {},
    "%lld left": {
      "comment": "A label showing the number of characters remaining in the feedback message field. The argument is the number of characters remaining.",
      "isCommentAutoGenerated": true
    },
    "%lld percent": {},
    "%lld star%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld star%2$@"
          }
        }
      }
    },
    "%lld years": {
      "comment": "The value of the age slider.",
      "isCommentAutoGenerated": true
    },
    "%lld/%lld": {
      "comment": "A label showing the number of characters in the comment text field. The first argument is the current number of characters in the text field. The second argument is the maximum allowed number of characters.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld/%2$lld"
          }
        }
      }
    },
    "%lld/%lld this week": {
      "comment": "A label displaying the number of used and total quota for the current week, followed by a separator and the name of the active subscription plan.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld/%2$lld this week"
          }
        }
      }
    },
    "%lld/wk · %@": {
      "comment": "A description of the perks of a subscription plan, including the number of weekly Grok credits and a promotional argument. The first argument is the number of weekly Grok credits included in the plan. The second argument is the promotional argument provided by the paywall.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld/wk · %2$@"
          }
        }
      }
    },
    "%lld%%": {
      "comment": "A label showing the percentage of the week that has been completed. The argument is the percentage of the week that has been completed.",
      "isCommentAutoGenerated": true
    },
    "~%lld kcal": {},
    "0.0": {
      "comment": "Placeholder text for the weight field in the manual weigh-in view.",
      "isCommentAutoGenerated": true
    },
    "9+": {
      "comment": "The text that appears on the badge when the number of unread notifications is greater than 9.",
      "isCommentAutoGenerated": true
    },
    "Age": {},
    "AGE": {},
    "Age %lld+ required. Full copies stay in Settings → Privacy & Legal.": {},
    "Age gate: %lld+. Controller: %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Age gate: %1$lld+. Controller: %2$@."
          }
        }
      }
    },
    "Alerts": {
      "comment": "Accessibility label for the bell.",
      "isCommentAutoGenerated": true
    },
    "Alerts, %lld unread": {
      "comment": "Accessibility label for the bell button.",
      "isCommentAutoGenerated": true
    },
    "Allergies and hard nos (peanuts, shellfish…)": {},
    "Anything else? (optional)": {},
    "App details": {},
    "Apple Health": {},
    "Apple Intelligence phones use the system model. Other compatible iPhones auto-install a private 0.5B Metal polish pack (~470 MB, Wi-Fi). Keel handles live Coach when consented.": {
      "comment": "A description of the on-device AI polish.",
      "isCommentAutoGenerated": true
    },
    "Apply": {},
    "Apply age": {},
    "Apply correction": {},
    "Avoid": {
      "comment": "A heading for the user's dietary preferences and food avoidances.",
      "isCommentAutoGenerated": true
    },
    "Blank = suggested": {},
    "Blank is fine. We may ask once in a while at key moments, never every day.": {
      "comment": "A description of the optional dietary preferences.",
      "isCommentAutoGenerated": true
    },
    "Body fat": {
      "comment": "The upper bound of the area is the body fat value.",
      "isCommentAutoGenerated": true
    },
    "Body fat % (optional)": {
      "comment": "A label for the user's body fat percentage.",
      "isCommentAutoGenerated": true
    },
