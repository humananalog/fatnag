    "How’s it going so far? One tap. No account, no survey." : {
      "comment" : "A description of the App Review Prompt.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How’s it going so far? One tap. No account, no survey."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué tal va hasta ahora? Un toque. Sin cuenta, sin encuesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça se passe comment ? Un tap. Pas de compte, pas de sondage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie läuft’s bisher? Ein Tipp. Kein Konto, keine Umfrage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come va finora? Un tap. Nessun account, nessun sondaggio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como está indo até agora? Um toque. Sem conta, sem pesquisa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como está a correr até agora? Um toque. Sem conta, sem inquérito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここまでどう？タップひとつ。アカウントもアンケートもなし。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금까지 어때요? 한 번만 탭. 계정 없고 설문 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到目前为止怎么样？点一下。不用账号，没有问卷。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到目前為止怎麼樣？點一下。不用帳號，沒有問卷。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe gaat het tot nu toe? Eén tik. Geen account, geen enquête."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur går det hittills? Ett tryck. Inget konto, ingen enkät."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan går det indtil videre? Ét tryk. Ingen konto, ingen undersøgelse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miten tähän asti? Yksi napautus. Ei tiliä, ei kyselyä."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan går det så langt? Ett trykk. Ingen konto, ingen undersøkelse."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak idzie do tej pory? Jedno stuknięcie. Bez konta, bez ankiety."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdiye kadar nasıl? Bir dokunuş. Hesap yok, anket yok."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как пока? Одно нажатие. Без аккаунта и без опроса."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كيف الحال حتى الآن؟ نقرة واحدة. بلا حساب وبلا استبيان."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अब तक कैसा चल रहा है? एक टैप। न खाता, न सर्वे।"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เป็นยังไงบ้างจนถึงตอนนี้ แตะครั้งเดียว ไม่มีบัญชี ไม่มีแบบสำรวจ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đến giờ thế nào? Một chạm. Không tài khoản, không khảo sát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagaimana sejauh ini? Satu ketukan. Tanpa akun, tanpa survei."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macam mana setakat ini? Satu ketikan. Tiada akaun, tiada tinjauan."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "איך הולך עד עכשיו? הקשה אחת. בלי חשבון, בלי סקר."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Як поки що? Один дотик. Без облікового запису і без опитування."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak to zatím jde? Jedno klepnutí. Žádný účet, žádný průzkum."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πώς πάει ως τώρα; Ένα πάτημα. Χωρίς λογαριασμό, χωρίς έρευνα."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hogy megy eddig? Egy koppintás. Nincs fiók, nincs kérdőív."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cum merge până acum? O atingere. Fără cont, fără sondaj."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako to zatiaľ ide? Jedno ťuknutie. Žiadny účet, žiadny prieskum."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kako ide dosad? Jedan dodir. Bez računa, bez ankete."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com va fins ara? Un toc. Sense compte, sense enquesta."
          }
        }
      }
    },
