    "goal.revision.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وجبات Commando مفعّلة: الاستهلاك ينخفض إلى الحد الأسبوعي الآمن. اختار Keel تاريخًا مسبقًا — ما زال يمكنك تغييره."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els àpats Commando estan activats: la ingesta baixa fins al màxim setmanal segur. Keel ha preseleccionat una data que encara pots canviar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commando jídla jsou zapnutá: příjem klesá na bezpečné týdenní max. Keel předvybral datum — pořád můžete změnit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commando-måltider er på: indtag falder til det sikre ugemaksimum. Keel har forvalgt en dato, du stadig kan ændre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commando-Mahlzeiten aktiv: Zufuhr fällt auf das sichere Wochenmaximum. Keel hat ein Datum vorausgewählt — du kannst es noch ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα Commando γεύματα είναι on: η πρόσληψη πέφτει στο ασφαλές εβδομαδιαίο max. Το Keel προεπέλεξε ημερομηνία — μπορείς ακόμα να την αλλάξεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commando meals are on: intake drops to the safe weekly max. Keel pre-selected a date you can still change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comidas Commando activadas: la ingesta baja al máximo semanal seguro. Keel preseleccionó una fecha que aún puedes cambiar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commando-ateriat päällä: saanti tippuu turvalliseen viikkomaksimiin. Keel esivalitsi päivämäärän, jota voit vielä muuttaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repas Commando activés : l’apport tombe au max hebdo sûr. Keel a présélectionné une date que tu peux encore changer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ארוחות Commando פעילות: הצריכה יורדת למקסימום השבועי הבטוח. Keel בחר תאריך מראש — עדיין אפשר לשנות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commando मील्स चालू: सेवन सुरक्षित साप्ताहिक अधिकतम तक। Keel ने तारीख चुनी — अभी भी बदल सकते हो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commando obroci su uključeni: unos pada na sigurni tjedni max. Keel je unaprijed odabrao datum — i dalje možeš promijeniti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commando étkezések bekapcsolva: a bevitel a biztonságos heti maxra esik. A Keel előre kiválasztott egy dátumot — még megváltoztathatod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meal Commando aktif: asupan turun ke maks mingguan aman. Keel memilih tanggal — masih bisa diubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasti Commando attivi: l’intake scende al max settimanale sicuro. Keel ha preselezionato una data che puoi ancora cambiare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コマンドー食がオン：摂取は安全な週間上限まで下がります。Keelが変更可能な日付を選びました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "특공대 식사가 켜져 있습니다: 섭취량이 안전한 주간 최대치로 떨어집니다. Keel은 여전히 변경할 수 있는 날짜를 미리 선택했습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hidangan Commando aktif: pengambilan turun ke had selamat mingguan. Keel telah pilih tarikh yang masih boleh diubah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commando-måltider er på: inntak synker til det trygge ukemaksimumet. Keel har forhåndsvalgt en dato du fortsatt kan endre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commando-maaltijden aan: inname daalt naar het veilige weekmaximum. Keel heeft een datum voorgekozen die je nog kunt wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posiłki Commando włączone: spożycie spada do bezpiecznego tygodniowego max. Keel wstępnie wybrał datę — nadal możesz zmienić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refeições Commando ativas: a ingestão cai no máximo semanal seguro. Keel pré-selecionou uma data que você ainda pode mudar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refeições Commando ativas: a ingestão cai no máximo semanal seguro. Keel pré-selecionou uma data que ainda podes mudar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesele Commando sunt on: aportul scade la max-ul săptămânal sigur. Keel a preselectat o dată pe care o poți schimba."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commando-приёмы пищи включены: набор падает до безопасного недельного max. Keel заранее выбрал дату — её ещё можно сменить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commando jedlá sú zapnuté: príjem klesá na bezpečné týždenné max. Keel predvolil dátum — stále môžeš zmeniť."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commando-måltider på: intaget sjunker till det säkra veckomaxet. Keel har förvalt ett datum du fortfarande kan ändra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โหมด Commando เปิด: แคลอรีลงมาเพดานปลอดภัยรายสัปดาห์ Keel เลือกวันล่วงหน้า—คุณยังเปลี่ยนได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commando öğünleri açık: alım güvenli haftalık max’a düşer. Keel bir tarih ön seçti — hâlâ değiştirebilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Страви Commando увімкнено: споживання падає до безпечного тижневого max. Keel наперед обрав дату — її ще можна змінити."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bữa Commando bật: lượng ăn hạ xuống trần tuần an toàn. Keel đã chọn sẵn ngày — bạn vẫn đổi được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commando 餐已开启：摄入降到安全周上限。Keel 预选了你仍可改的日期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
