    "progress.privacy.body": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملخص اتجاه وزن/دهون قصير فقط يذهب إلى Keel عند الضغط على roast. ألغِ في الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur eine kurze Gewichts-/Fett-Trend-Zusammenfassung geht an Keel, wenn du Roast tippst. Widerruf in Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a short weight/fat trend summary goes to Keel when you tap roast. Revoke in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un resumen corto de tendencia de peso/grasa va a Keel cuando tocas roast. Revoca en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul un court résumé poids/graisse va à Keel quand tu tapes roast. Révoque dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un breve riepilogo di tendenza peso/grasso va a Keel quando tocchi roast. Revoca in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローストをタップすると短い体重／脂肪トレンド要約だけがKeelへ。設定で取り消せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로스트를 누르면 짧은 체중/지방 추세 요약만 용골로 이동합니다. 설정에서 취소합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen een korte gewicht/vet-trendsamenvatting gaat naar Keel als je roast tikt. Intrekken in Instellingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só um resumo curto de tendência de peso/gordura vai ao Keel quando você toca roast. Revogue em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только короткий тренд веса/жира уходит в Keel по тапу roast. Отозвать в Настройках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点 roast 时只有短体重/体脂趋势摘要发给 Keel。可在设置撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點 roast 時僅向 Keel 傳送簡短體重／體脂趨勢摘要。可在設定中撤銷。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només un resum curt de les tendències de pes/greix es dirigeix a la Quilla quan prens rostit. Revoca a Configuració."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen krátký trend váhy/tuku jde do Keel po klepnutí na roast. Odvolat v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun et kort vægt/fedt-tendensresume går til Keel, når du trykker roast. Tilbagekald i Indstillinger."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο σύντομη περίληψη τάσης βάρους/λίπους πάει στο Keel όταν πατήσεις roast. Ανάκληση στις Ρυθμίσεις."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain lyhyt paino/rasva-trendiyhteenveto menee Keeliin kun napautat roastia. Peru Asetuksissa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק סיכום מגמת משקל/שומן קצר הולך ל־Keel בלחיצה על roast. בטל בהגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "roast टैप पर केवल छोटा वज़न/फैट ट्रेंड सार Keel को जाता है। सेटिंग्स में रद्द करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo kratki trend težine/masti ide na Keel kad tapneš roast. Poništi u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak egy rövid súly/zsír trend összefoglaló megy a Keelnek, ha roastot koppintasz. Vond vissza a Beállításokban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya ringkasan tren berat/lemak pendek ke Keel saat ketuk roast. Cabut di Pengaturan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya ringkas trend berat/lemak pendek ke Keel bila ketik roast. Tarik balik dalam Settings."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare et kort vekt/fett-trendsammendrag går til Keel når du trykker roast. Tilbakekall i Innstillinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko krótki trend wagi/tłuszczu idzie do Keel po tapnięciu roast. Cofnij w Ustawieniach."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só um resumo curto de tendência de peso/gordura vai ao Keel quando tocas roast. Revoga em Definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar un rezumat scurt de tendință greutate/grăsime merge la Keel când atingi roast. Revocă în Setări."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Len krátky trend váhy/tuku ide do Keel po klepnutí na roast. Odvolať v Nastaveniach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara en kort vikt/fett-trendsammanfattning går till Keel när du trycker roast. Återkalla i Inställningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กด roast แล้วส่งสรุปเทรนด์น้ำหนัก/ไขมันสั้นๆ ไป Keel เท่านั้น ถอนได้ในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Roast’a dokununca yalnızca kısa bir ağırlık/yağ trend özeti Keel’e gider. Ayarlar’dan geri al."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише короткий тренд ваги/жиру йде в Keel після тапу roast. Відкликай у Налаштуваннях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ tóm tắt xu hướng cân/mỡ ngắn gửi Keel khi bạn chạm roast. Thu hồi trong Cài đặt."
          }
        }
      }
