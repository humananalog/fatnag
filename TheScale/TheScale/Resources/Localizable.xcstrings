    "subscription.thanks.welcome" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرحبًا بك في %@. لدى Keel متسع أكبر لك هذا الأسبوع — %d رصيدًا. يسعدنا وجودك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benvingut a %@. Keel té més lloc per a tu aquesta setmana — %d crèdits. Ens alegra que siguis aquí."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vítej v %@. Keel má tento týden víc místa — %d kreditů. Jsme rádi, že jsi tady."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velkommen til %@. Keel har mere plads til dig i denne uge — %d credits. Dejligt du er her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen bei %@. Keel hat diese Woche mehr Raum für dich — %d Credits. Schön, dass du da bist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καλώς ήρθες στο %@. Ο Keel έχει περισσότερο χώρο αυτή την εβδομάδα — %d μονάδες. Χαιρόμαστε που είσαι εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome to %@. Keel has more room for you this week — %d credits. We're glad you're here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienvenido a %@. Keel tiene más sitio para ti esta semana: %d créditos. Nos alegra que estés aquí."
