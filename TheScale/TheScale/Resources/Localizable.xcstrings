        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부드러운 천장이 없습니다. %d LIVE Keel은 일주일에 크레딧을 받습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen zacht plafond. %d live Keel-credits per week."
