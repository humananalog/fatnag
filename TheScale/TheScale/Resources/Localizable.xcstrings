    "settings.persona.help": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tone stays on-device until you consent to a live Keel ask."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ton reste sur l’appareil jusqu’à ton consentement pour une demande Keel live."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トーンは端末内。ライブKeelへの同意までオフ端末。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النبرة تبقى على الجهاز حتى توافق على سؤال Keel live."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El to romandrà en el dispositiu fins que donis el teu consentiment per fer una pregunta en directe a Keel."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tón zůstává na zařízení, dokud nesouhlasíš s live otázkou Keel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonen bliver på enheden, indtil du samtykker til et live Keel-spørgsmål."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton bleibt auf dem Gerät, bis du einer Live-Keel-Frage zustimmst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο τόνος μένει στη συσκευή μέχρι να συναινέσεις σε live ερώτηση Keel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tono se queda en el dispositivo hasta que consientas una pregunta Keel LIVE."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sävy pysyy laitteella kunnes suostut live Keel -kysymykseen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הטון נשאר במכשיר עד שתסכים לשאלת Keel live."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टोन डिवाइस पर रहता है जब तक Live Keel सवाल की सहमति न दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton ostaje na uređaju dok ne pristaneš na live pitanje Keel."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hangnem az eszközön marad, amíg nem járulsz hozzá egy live Keel kérdéshez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada tetap di perangkat sampai kamu setuju pertanyaan Live Keel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tono resta sul dispositivo finché non acconsenti a una domanda Keel LIVE."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 Keel 요청에 동의할 때까지 어조는 장치에 그대로 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada kekal pada peranti sehingga anda bersetuju permintaan Live Keel."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonen blir på enheten til du samtykker til et live Keel-spørsmål."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon blijft op het apparaat tot je toestemt voor een live Keel-vraag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton zostaje na urządzeniu, dopóki nie wyrazisz zgody na live pytanie Keel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tom fica no aparelho até você consentir uma pergunta Keel LIVE."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O tom fica no dispositivo até consentires uma pergunta Keel LIVE."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonul rămâne pe dispozitiv până consimți la o întrebare Keel LIVE."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тон остаётся на устройстве, пока не дашь согласие на live вопрос Keel."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tón zostáva na zariadení, kým nesúhlasíš s live otázkou Keel."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonen stannar på enheten tills du samtycker till en live Keel-fråga."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทนอยู่บนเครื่องจนกว่าจะยินยอมคำถาม Live Keel"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton, live Keel sorusuna onay verene kadar cihazda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тон лишається на пристрої, доки не даси згоду на live запит Keel."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tông ở trên máy đến khi bạn đồng ý hỏi Live Keel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语气留在本机，直到你同意一次 Live Keel 请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語氣留在裝置上，直到你同意一次 Live Keel 提問。"
          }
        }
      }
    },
