    "coach.privacy.body": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط هذه الدردشة مع ملخص قصير للوزن/الدهون/اللياقة تذهب إلى خلفية Keel المشتركة. الذاكرة تبقى على الجهاز باستثناء الحقائق ذات الصلة بالسؤال. بلا مفتاح API لكل مستخدم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur dieser Chat plus ein kurzer Gewichts-/Fett-/Fitness-Digest gehen an das gemeinsame Keel-Backend. Speicher bleibt auf dem Gerät, außer Fakten zur Frage. Kein persönlicher API-Schlüssel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this chat plus a short weight/fat/fitness digest go to the shared Keel backend. Memory stays on-device except the facts relevant to the ask. No per-user API key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo este chat y un resumen corto de peso/grasa/fitness van al backend compartido de Keel. La memoria se queda en el dispositivo salvo los hechos relevantes a la pregunta. Sin API key por usuario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul ce chat plus un court digest poids/graisse/forme vont au backend Keel partagé. La mémoire reste sur l’appareil sauf les faits utiles à la demande. Pas de clé API par utilisateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo questa chat e un breve digest peso/grasso/fitness vanno al backend Keel condiviso. La memoria resta sul dispositivo tranne i fatti rilevanti alla domanda. Nessuna API key per utente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットと短い体重／体脂肪／フィットネス要約だけが共有Keelバックエンドへ。メモリは端末内。ユーザー別APIキーなし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 채팅과 짧은 체중/지방/피트니스 다이제스트만 공유된 용골 백엔드로 이동합니다. 요청과 관련된 사실을 제외하고는 장치에 메모리가 남아 있습니다. 사용자별 API 키가 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen deze chat plus een korte gewicht/vet/fitness-digest gaan naar de gedeelde Keel-backend. Memory blijft op het apparaat, behalve feiten relevant voor de vraag. Geen API-sleutel per gebruiker."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só este chat e um resumo curto de peso/gordura/fitness vão ao backend compartilhado do Keel. A memória fica no aparelho, exceto os fatos relevantes à pergunta. Sem API key por usuário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только этот чат плюс короткий digest веса/жира/формы уходят на общий Keel backend. Память на устройстве, кроме фактов к вопросу. Без API-ключа на пользователя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有此聊天加上简短的体重/脂肪/健身摘要才能转到共享的Keel后端。除了与询问相关的事实外，记忆保持在设备上。没有每个用户的API密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅此聊天加上簡短體重／體脂／體能摘要會傳到共用 Keel 後端。記憶留在裝置上，僅傳送與問題相關的事實。無按使用者 API key。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només aquest xat més un resum curt de pes/greix/forma física van al dorsal de Keel compartit. La memòria es manté en el dispositiu, excepte els fets rellevants per a la pregunta. No hi ha cap clau API per usuari."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen tento chat plus krátký digest váhy/tuku/kondice jdou na sdílený Keel backend. Paměť zůstává na zařízení kromě faktů k otázce. Žádný API klíč na uživatele."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun denne chat plus et kort vægt/fedt/fitness-digest går til den delte Keel-backend. Hukommelse bliver på enheden undtagen fakta relevante for spørgsmålet. Ingen API-nøgle pr. bruger."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο αυτό το chat και ένα σύντομο digest βάρους/λίπους/φόρμας πάνε στο κοινό Keel backend. Η μνήμη μένει στη συσκευή εκτός από τα σχετικά γεγονότα. Χωρίς API key ανά χρήστη."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain tämä chat plus lyhyt paino/rasva/kunto-digest menevät jaettuun Keel-backendiin. Muisti pysyy laitteella paitsi kysymykseen liittyvät faktat. Ei käyttäjäkohtaista API-avainta."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק הצ׳אט הזה בתוספת תקציר קצר של משקל/שומן/כושר הולכים ל־Keel backend משותף. הזיכרון נשאר במכשיר מלבד עובדות רלוונטיות לשאלה. בלי מפתח API למשתמש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल यह चैट और छोटा वज़न/फैट/फिटनेस सार साझा Keel बैकएंड पर जाता है। मेमोरी डिवाइस पर रहती है, सवाल से जुड़े तथ्यों को छोड़कर। प्रति-उपयोगकर्ता API key नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo ovaj chat plus kratki digest težine/masti/forme idu na zajednički Keel backend. Pamćenje ostaje na uređaju osim činjenica relevantnih za pitanje. Bez API ključa po korisniku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak ez a chat plusz egy rövid súly/zsír/fitnesz digest megy a közös Keel backendre. A memória az eszközön marad, kivéve a kérdéshez releváns tényeket. Nincs felhasználónkénti API kulcs."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya chat ini plus ringkasan pendek berat/lemak/kebugaran ke backend Keel bersama. Memori tetap di perangkat kecuali fakta relevan. Tanpa API key per pengguna."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya sembang ini plus ringkas berat/lemak/kecergasan pendek ke backend Keel dikongsi. Memori kekal pada peranti kecuali fakta relevan. Tiada API key setiap pengguna."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare denne chatten pluss et kort vekt/fett/fitness-digest går til den delte Keel-backend. Minne blir på enheten unntatt fakta relevante for spørsmålet. Ingen API-nøkkel per bruker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko ten czat oraz krótki digest wagi/tłuszczu/kondycji idą na wspólny backend Keel. Pamięć zostaje na urządzeniu, poza faktami istotnymi do pytania. Bez klucza API na użytkownika."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só este chat e um resumo curto de peso/gordura/fitness vão para o backend partilhado do Keel. A memória fica no dispositivo, exceto os factos relevantes à pergunta. Sem API key por utilizador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar acest chat plus un digest scurt greutate/grăsime/fitness merg la backend-ul Keel partajat. Memoria rămâne pe dispozitiv, exceptând faptele relevante întrebării. Fără cheie API per utilizator."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Len tento chat plus krátky digest váhy/tuku/kondície idú na spoločný Keel backend. Pamäť zostáva na zariadení okrem faktov k otázke. Žiadny API kľúč na používateľa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara den här chatten plus en kort vikt/fett/fitness-digest går till den delade Keel-backend. Minne stannar på enheten utom fakta som hör till frågan. Ingen API-nyckel per användare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะแชทนี้กับสรุปน้ำหนัก/ไขมัน/ฟิตเนสสั้นๆ ไปยัง Keel ร่วม ความจำอยู่บนเครื่อง ยกเว้นข้อเท็จจริงที่เกี่ยวกับคำถาม ไม่มี API key รายผู้ใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu sohbet artı kısa bir ağırlık/yağ/fitness özeti ortak Keel backend’ine gider. Bellek, soruya ilgili gerçekler dışında cihazda kalır. Kullanıcı başına API anahtarı yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише цей чат плюс короткий digest ваги/жиру/форми йдуть на спільний Keel backend. Пам’ять лишається на пристрої, окрім фактів до запиту. Без API-ключа на користувача."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ chat này cùng tóm tắt cân/mỡ/thể lực ngắn gửi lên Keel dùng chung. Bộ nhớ ở trên máy trừ các sự kiện liên quan câu hỏi. Không có API key theo người dùng."
          }
        }
      }
