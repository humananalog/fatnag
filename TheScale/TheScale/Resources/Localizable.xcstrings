    "meal.empty.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull refresh, or weigh in — Keel fills the plate from your deficit."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب للتحديث أو وزّن — Keel يملأ الطبق من عجزك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualitza o pesa: la quilla omple la placa des del teu dèficit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přetáhni obnovení nebo se zvaž — Keel naplní talíř z deficitu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk for at opdatere, eller vej ind — Keel fylder tallerkenen fra dit underskud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Aktualisieren ziehen oder einwiegen — Keel füllt den Teller aus deinem Defizit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τράβα ανανέωση ή ζυγίσου — το Keel γεμίζει το πιάτο από το έλλειμμα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira para actualizar, o pésate — Keel llena el plato desde tu déficit."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä päivittääksesi, tai punnitse — Keel täyttää lautasen vajeestasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tire pour actualiser, ou pèse-toi — Keel remplit l’assiette depuis ton déficit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משוך רענון או שקול — Keel ממלא את הצלחת מהגירעון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खींचकर रीफ़्रेश करें, या तौलें — Keel आपके डेफ़िसिट से प्लेट भरता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povuci osvježi ili se izvagu — Keel puni tanjur iz deficita."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd a frissítést, vagy mérj — a Keel a deficitből tölti a tányért."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarik refresh, atau timbang — Keel isi piring dari defisitmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira per aggiornare, o pesati — Keel riempie il piatto dal tuo deficit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引っ張って更新、または計量 — Keelが赤字からプレートを埋める。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로 고침을 당기거나 무게를 재세요. 용골이 적자에서 판을 채웁니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarik muat semula, atau timbang — Keel isi pinggan dari defisit anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trekk for å oppdatere, eller vei inn — Keel fyller tallerkenen fra underskuddet ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trek om te vernieuwen, of weeg in — Keel vult het bord vanuit je deficit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pociągnij, by odświeżyć, albo zważ się — Keel ułoży talerz z deficytu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Puxe para atualizar, ou pese-se — Keel monta o prato a partir do seu déficit."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Puxa para atualizar, ou pesa-te — Keel monta o prato a partir do teu défice."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage pentru refresh, sau cântărește-te — Keel umple farfuria din deficitul tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потяни обновление или взвесься — Keel соберёт тарелку из дефицита."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahni obnovenie alebo sa odvaž — Keel naplní tanier z deficitu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra för att uppdatera, eller väg in — Keel fyller tallriken från ditt underskott."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดึงรีเฟรช หรือชั่ง — Keel จัดจานจากเดฟิซิตของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yenilemeyi çek veya tartıl — Keel tabağı açıktan doldurur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потягни оновлення або зважся — Keel збере тарілку з дефіциту."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo làm mới, hoặc cân — Keel xếp đĩa từ thâm hụt của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下拉刷新，或称重 — Keel 按你的赤字排餐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下拉重新整理，或量體重 — Keel 依你的缺口排盤。"
          }
        }
      }
    },
