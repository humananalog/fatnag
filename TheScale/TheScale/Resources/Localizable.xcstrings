        }
      }
    },
    "onboarding.sub.lifestyle": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختياري. اتركه فارغًا؛ قد نسأل بلطف لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Leer lassen; wir fragen später sanft nach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Leave blank; we may ask gently later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Déjalo vacío; quizá preguntemos con suavidad después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionnel. Laisse vide ; on peut demander plus tard, gentiment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Opzionale. Lascia vuoto; forse chiederemo dopo, con calma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意。空欄のままでも、あとで優しく聞くかも。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항. 비워두세요. 나중에 부드럽게 요청할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel. Laat leeg; we vragen later zachtjes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Deixe em branco; talvez perguntemos depois, com calma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опционально. Оставь пустым; позже можем мягко спросить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。留空；我们稍后可能会温和地询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可選。可留空；我們之後可能輕聲再問。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Deixa-ho en blanc; podem demanar-ho suaument més endavant."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Volitelné. Nech prázdné; možná se jemně zeptáme později."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfrit. Lad være tom; vi spørger måske mildt senere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προαιρετικό. Άφησέ το κενό· ίσως ρωτήσουμε απαλά αργότερα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valinnainen. Jätä tyhjäksi; voimme kysyä pehmeästi myöhemmin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אופציונלי. השאר ריק; אולי נשאל בעדינות אחר כך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक। खाली छोड़ें; बाद में धीरे से पूछ सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcionalno. Ostavi prazno; možda pitamo blago kasnije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcionális. Hagyd üresen; később finoman kérdezhetünk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsional. Kosongkan; kami mungkin bertanya pelan nanti."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan. Biarkan kosong; kami mungkin tanya lembut kemudian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfritt. La stå tomt; vi kan spørre mildt senere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalne. Zostaw puste; możemy delikatnie zapytać później."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Deixa em branco; talvez perguntemos depois, com calma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Opțional. Lasă gol; poate întrebăm blând mai târziu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Voliteľné. Nechaj prázdne; možno sa jemne spýtame neskôr."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valfritt. Lämna tomt; vi kan fråga milt senare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่บังคับ เว้นว่างได้ อาจถามเบาๆ ทีหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı. Boş bırak; sonra nazikçe sorabiliriz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Опційно. Залиш порожнім; пізніше можемо м’яко запитати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chọn. Để trống; có thể hỏi nhẹ sau."
          }
        }
      }
    },
