    "settings.alerts.morning_help": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About 06:30 local, or soon after Health wake. Window closes at 08:00. Skips the day if you already weighed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vers 06:30 locale, ou juste après le réveil Santé. Fenêtre jusqu’à 08:00. Saute le jour si tu t’es déjà pesé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現地06:30頃、またはヘルスケア起床後。08:00で窓が閉じます。既に計量済みならスキップ。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حوالي 06:30 محليًا، أو بعد استيقاظ Health بقليل. النافذة تُغلق عند 08:00. يتخطى اليوم إن وزنت بالفعل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproximadament a les 06:30 de la localitat, o poc després del despertar de Salut. La finestra es tanca a les 08:00. S'salta el dia si ja has pesat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolem 06:30 místního, nebo brzy po probuzení v Health. Okno končí v 08:00. Přeskočí den, pokud už jsi vážil."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Cirka 06:30 lokal, eller snart efter Health-vågning. Vinduet lukker kl. 08:00. Springer dagen over, hvis du allerede har vejet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca. 06:30 lokal, oder bald nach Health-Aufwachen. Fenster schließt um 08:00. Überspringt den Tag, wenn du schon gewogen hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περίπου 06:30 τοπική, ή λίγο μετά αφύπνιση Health. Το παράθυρο κλείνει στις 08:00. Παραλείπει τη μέρα αν ήδη ζυγίστηκες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacia las 06:30 local, o poco después del despertar de Health. La ventana cierra a las 08:00. Se salta el día si ya te pesaste."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Noin 06:30 paikallista, tai pian Health-herätyksen jälkeen. Ikkuna sulkeutuu 08:00. Ohittaa päivän jos olet jo punninnut."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בערך 06:30 מקומי, או זמן קצר אחרי התעוררות Health. החלון נסגר ב־08:00. מדלג על היום אם כבר שקלת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लगभग 06:30 स्थानीय, या Health जागने के बाद। विंडो 08:00 बंद। पहले तौल चुके तो दिन छोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oko 06:30 lokalno, ili ubrzo nakon buđenja u Health. Prozor se zatvara u 08:00. Preskače dan ako si već vagao."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kb. 06:30 helyi idő, vagy hamar Health ébredés után. Az ablak 08:00-kor zárul. Kihagyja a napot, ha már mértél."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekitar 06:30 lokal, atau segera setelah Health bangun. Jendela tutup 08:00. Lewati hari jika sudah menimbang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verso le 06:30 locali, o poco dopo il risveglio Health. La finestra chiude alle 08:00. Salta il giorno se ti sei già pesato."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 06:30 현지, 또는 Health가 깨어난 직후. 08:00 에 창이 닫힙니다. 이미 체중을 측정했다면 하루를 건너뛰세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kira-kira 06:30 tempatan, atau selepas Health bangun. Tingkap tutup pada 08:00. Langkau hari jika sudah timbang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Omtrent 06:30 lokal, eller snart etter Health-våkning. Vinduet lukker kl. 08:00. Hopper over dagen hvis du allerede har veid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rond 06:30 lokaal, of kort na Health-wakker. Venster sluit om 08:00. Slaat de dag over als je al gewogen hebt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Około 06:30 lokalnie, albo tuż po przebudzeniu w Health. Okno zamyka się o 08:00. Pomija dzień, jeśli już się zważyłeś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por volta das 06:30 locais, ou logo após o despertar do Health. A janela fecha às 08:00. Pula o dia se você já pesou."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Por volta das 06:30 locais, ou logo após o despertar do Health. A janela fecha às 08:00. Salta o dia se já pesaste."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cam pe 06:30 local, sau imediat după trezirea din Health. Fereastra se închide la 08:00. Sare ziua dacă te-ai cântărit deja."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Около 06:30 по местному, или вскоре после пробуждения в Health. Окно закрывается в 08:00. Пропускает день, если уже взвесился."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Okolo 06:30 miestneho, alebo skoro po prebudení v Health. Okno končí o 08:00. Preskočí deň, ak si už vážil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Cirka 06:30 lokal, eller snart efter Health-vakna. Fönstret stänger 08:00. Hoppar över dagen om du redan vägt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ราว 06:30 ตามท้องถิ่น หรือหลัง Health ตื่น หน้าต่างปิด 08:00 ข้ามวันถ้าชั่งแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel ~06:30 veya Health uyanışından kısa sonra. Pencere 08:00’de kapanır. Zaten tartıldıysan günü atlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Близько 06:30 за місцевим, або невдовзі після пробудження в Health. Вікно зачиняється о 08:00. Пропускає день, якщо вже зважився."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoảng 06:30 giờ địa phương, hoặc sau khi Health thức. Cửa sổ đóng lúc 08:00. Bỏ qua nếu đã cân."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大约当地时间06:30 ，或在Health wake后不久。窗口于08:00关闭。如果您已经称重，则跳过这一天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "約本地 06:30，或 Health 醒來後不久。視窗 08:00 關閉。若已量體重則跳過當天。"
          }
        }
      }
    },
