    "Update age to %lld years? Dream targets and suggested body fat will refresh." : {
      "comment" : "A confirmation alert asking the user to confirm a change to their age.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحديث العمر إلى %lld سنة؟ ستتجدد أهداف الحلم ونسبة الدهون المقترحة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualitzar l’edat a %lld anys? Els objectius somiats i el greix corporal suggerit s’actualitzaran."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizovat věk na %lld let? Vysněné cíle a navržený tělesný tuk se přepočítají."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opdater alder til %lld år? Drømmemål og foreslået kropsfedt opdateres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alter auf %lld Jahre setzen? Traumziele und vorgeschlagener Körperfettanteil werden neu berechnet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενημέρωση ηλικίας σε %lld έτη; Οι στόχοι-όνειρο και το προτεινόμενο λίπος θα ανανεωθούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update age to %lld years? Dream targets and suggested body fat will refresh."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Actualizar la edad a %lld años? Los objetivos soñados y la grasa corporal sugerida se actualizarán."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päivitetäänkö ikä %lld vuoteen? Unelmatavoitteet ja ehdotettu rasva päivittyvät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettre l’âge à %lld ans ? Les objectifs rêvés et la masse grasse suggérée seront recalculés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לעדכן גיל ל-%lld שנים? יעדי החלום ושומן הגוף המוצע יתרעננו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उम्र %lld वर्ष करें? सपनों के लक्ष्य और सुझाई बॉडी फैट ताज़ा होगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ažurirati dob na %lld godina? Ciljevi iz snova i predložena tjelesna mast će se osvježiti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frissítsem a kort %lld évre? Az álomcélok és a javasolt testzsír frissülnek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perbarui usia ke %lld tahun? Target impian dan lemak tubuh yang disarankan akan disegarkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiornare l’età a %lld anni? Gli obiettivi dei sogni e il grasso corporeo suggerito si aggiorneranno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "年齢を %lld 歳に更新しますか？目標体重と提案体脂肪が更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나이를 %lld세로 업데이트할까요? 목표와 제안 체지방이 새로 계산됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kemas kini umur kepada %lld tahun? Sasaran impian dan lemak badan yang dicadangkan akan disegarkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppdatere alder til %lld år? Drømmemål og foreslått kroppsfett oppdateres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leeftijd bijwerken naar %lld jaar? Droomdoelen en voorgesteld vetpercentage worden ververst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaktualizować wiek do %lld lat? Cele marzeń i sugerowany tłuszcz zostaną odświeżone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualizar a idade para %lld anos? As metas dos sonhos e a gordura corporal sugerida serão atualizadas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualizar a idade para %lld anos? As metas de sonho e a gordura corporal sugerida serão atualizadas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualizezi vârsta la %lld ani? Țintele visate și grăsimea corporală sugerată se reîmprospătează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновить возраст до %lld лет? Цели мечты и предложенный жир обновятся."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizovať vek na %lld rokov? Vysnívané ciele a navrhnutý telesný tuk sa prepočítajú."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
