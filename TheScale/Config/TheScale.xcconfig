// Shared build settings for FATNAG.
// Xcode includes THIS file (Debug + Release baseConfigurationReference in project.pbxproj).
// Non-secret defaults live here so every checkout gets the shared Grok proxy URL.
// Optional local overrides: copy Secrets.example.xcconfig → Secrets.xcconfig (gitignored).
// Never put a real XAI key in this tracked file. Prefer the Cloudflare Worker secret.
//
// IMPORTANT: xcconfig treats // as a comment. Never write https:// literally.
// Use https:/$()/host so the build setting expands to https://host.

GROK_PROXY_URL = https:/$()/the-scale-grok.alexhuther.workers.dev
GROK_API_KEY =
// App ↔ Worker shared secret (NOT the xAI master key). Leave empty in git; set in Secrets.xcconfig.
// Empty → fail closed (offline Coach) even when GROK_PROXY_URL is set.
GROK_APP_SECRET =
// Anonymous product telemetry Worker (same APP_SHARED_SECRET as Grok proxy).
TELEMETRY_URL = https:/$()/fatnag-telemetry.alexhuther.workers.dev
// Optional override for feedback Edge Function anon key (defaults baked in ScaleFeedbackConfig).
SUPABASE_ANON_KEY =

#include? "Secrets.xcconfig"
