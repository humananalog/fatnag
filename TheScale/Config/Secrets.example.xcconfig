// Optional local override next to TheScale.xcconfig (the file Xcode actually includes).
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
// Secrets.xcconfig is gitignored. Never commit a real key.
//
// Canonical tracked defaults (proxy URL, empty key) live in TheScale.xcconfig.
// Use Secrets.xcconfig only to override those locally.
//
// Preferred (key stays server-side): Cloudflare Worker proxy.
// 1. On your Mac: cd workers/grok-proxy && npx wrangler secret put XAI_API_KEY
//    (paste the key into the terminal prompt; do not put it in chat)
// 2. npx wrangler deploy
// 3. Proxy URL is already in TheScale.xcconfig; override here only if needed:
// GROK_PROXY_URL = https://the-scale-grok.the-scale-grok.workers.dev
//
// Fallback (private TestFlight / Ad Hoc only): bake the key into the IPA via Info.plist.
// Anyone with the IPA can extract this. Prefer the proxy for shared distribution.
// GROK_API_KEY = xai-your-key-here
//
// Leave both empty (and clear TheScale.xcconfig defaults) for offline mock coaching.

GROK_PROXY_URL =
GROK_API_KEY =
