// Optional local override next to TheScale.xcconfig (the file Xcode actually includes).
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
// Secrets.xcconfig is gitignored. Never commit a real key or shared secret.
//
// Canonical tracked defaults (proxy URL) live in TheScale.xcconfig:
//   GROK_PROXY_URL = https:/$()/the-scale-grok.alexhuther.workers.dev
// Do NOT set GROK_PROXY_URL= (empty) here — that wipes the tracked URL.
//
// IMPORTANT: xcconfig treats // as a comment. Never write https:// literally.
// Use https:/$()/host so it expands to https://host.
//
// Required for live Coach (same value as Worker APP_SHARED_SECRET):
GROK_APP_SECRET =

// Optional overrides only if needed:
// GROK_PROXY_URL = https:/$()/the-scale-grok.alexhuther.workers.dev
// GROK_API_KEY =
// SUPABASE_ANON_KEY =
