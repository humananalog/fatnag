// Optional local override next to TheScale.xcconfig (the file Xcode actually includes).
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
// Secrets.xcconfig is gitignored. Never commit a real key or shared secret.
//
// Canonical tracked defaults (proxy URL, empty secrets) live in TheScale.xcconfig.
// Use Secrets.xcconfig only to override those locally.
//
// IMPORTANT: xcconfig treats // as a comment. Never write https:// literally.
// Use https:/$()/host so it expands to https://host.
//
// Preferred (xAI key stays server-side): Cloudflare Worker proxy + shared app secret.
// 1. On your Mac:
//      cd workers/grok-proxy
//      npx wrangler secret put XAI_API_KEY
//      openssl rand -hex 32   # copy output
//      npx wrangler secret put APP_SHARED_SECRET   # paste same value
//      npx wrangler deploy
// 2. Put that same APP_SHARED_SECRET value here as GROK_APP_SECRET (Debug + Release fail closed without it).
// 3. Proxy URL is already in TheScale.xcconfig; override here only if needed:
// GROK_PROXY_URL = https:/$()/the-scale-grok.the-scale-grok.workers.dev
//
// Fallback (private TestFlight / Ad Hoc only): bake the xAI key into the IPA via Info.plist.
// Anyone with the IPA can extract this. Prefer the proxy for shared distribution.
// GROK_API_KEY = xai-your-key-here
//
// Leave secrets empty (and clear TheScale.xcconfig defaults) for offline mock coaching.

GROK_PROXY_URL =
GROK_API_KEY =
GROK_APP_SECRET =

// Optional: override baked anon key used only to call submit-feedback Edge Function.
// SUPABASE_ANON_KEY = eyJ...
SUPABASE_ANON_KEY =
